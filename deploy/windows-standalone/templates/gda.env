# Generated from this template by install_offline_bundle.ps1.
# Values are absolute Windows paths; do not add network URLs in the isolated site.
DB_BACKEND=__DB_BACKEND__
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=gis_agent
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
