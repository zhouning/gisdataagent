GDA_DUCKDB_SPATIAL_EXTENSION_PATH=__INSTALL_ROOT__\payload\middleware\duckdb\extensions\spatial.duckdb_extension
GDA_FILE_LAKE_ROOT=__DATA_ROOT__\file_lake
GDA_FILE_LAKE_INBOX=__INBOX_ROOT__
GDA_LOCAL_INGEST_DIRS=__INBOX_ROOT__
GDA_OFFLINE_INGEST_AUTH_REQUIRED=true
GDA_STANDARD_CONTRACTS=__CONFIG_ROOT__\natural_resource_standard_contracts.json
GDA_NATURAL_RESOURCE_STANDARD_VERSION=NX-2026-08-baseline
GDA_ONTOLOGY_ACTIVE=__CONFIG_ROOT__\ontology\natural_resource_one_map\active.json
GDA_LOG_DIR=__LOG_ROOT__
GDA_PROJ_DATA=__PROJ_DATA__
GDA_GDAL_DATA=__GDAL_DATA__
GDA_LOG_ROTATION_MB=50
GDA_LOG_BACKUP_COUNT=14
GDA_INGEST_SETTLE_SECONDS=60
GDA_DIAGNOSTIC_RETENTION_DAYS=365
GDA_STANDARDIZED_VECTOR_FORMAT=__STANDARDIZED_VECTOR_FORMAT__
GDA_POSTGIS_DSN=__POSTGIS_DSN__
GDA_INGEST_EMBEDDED_WORKER=0
GDA_INGEST_SCHEDULE_DRIVER=internal
GDA_INGEST_LAKE_BACKEND=local
GDA_INGEST_LAKE_ROOT=__DATA_ROOT__\file_lake
GDA_INGEST_PLATFORM_BRIDGE=0
GDA_PAPER9_HOME=__INSTALL_ROOT__\payload\paper9
PAPER9_FARMLAND_MPC_REPO=__INSTALL_ROOT__\payload\paper9\source
PAPER9_FARMLAND_MPC_HOME=__INSTALL_ROOT__\payload\paper9\source
PAPER9_MODELS_ROOT=__INSTALL_ROOT__\payload\models\paper9
PAPER9_RESULTS_DIR=__DATA_ROOT__\paper9\runs
PAPER9_AGENT_MEMORY_PATH=__DATA_ROOT__\paper9\agent-memory.json
OLLAMA_API_BASE=http://127.0.0.1:11434
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_MODELS=__DATA_ROOT__\ollama-models
OLLAMA_EXE=__OLLAMA_EXE__
OLLAMA_MODEL=Gemma4:26b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe
# OpenAI-compatible chat configuration. For the bundled Ollama default these
# point to loopback; an internal LM Studio deployment only needs these values
# changed in config\gda.env (no Python changes or package rebuild).
GDA_LLM_PROVIDER=ollama
GDA_LLM_BASE_URL=http://127.0.0.1:11434/v1
GDA_LLM_MODEL=Gemma4:26b
GDA_LLM_API_KEY=ollama
GDA_LLM_TIMEOUT_SECONDS=180
GDA_MODEL_PREFLIGHT_REQUIRED=true
MODEL_BACKEND=lm_studio
ROUTER_MODEL=__ROUTER_MODEL__
MODEL_FAST=__ROUTER_MODEL__
MODEL_STANDARD=__ROUTER_MODEL__
MODEL_PREMIUM=__ROUTER_MODEL__
MODEL_CONFIG_FORCE_ENV=true
NL2SQL_AGENT_MODEL=__ROUTER_MODEL__
NL2SQL_LLM_SCHEMA_MAPPER_MODEL=__ROUTER_MODEL__
EMBEDDING_MODEL=nomic-embed-text-v2-moe
# Set these to lm_studio plus the exact /v1/models ID when using a remote
# internal LM Studio server. The embedding URL may be omitted when it is the
# same as GDA_LLM_BASE_URL.
GDA_EMBEDDING_PROVIDER=ollama
GDA_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
GDA_EMBEDDING_API_KEY=ollama
EMBEDDING_DIMENSION=768
FUSEKI_URL=http://127.0.0.1:3030
JAVA_HOME=__JAVA_HOME__
ONTOLOGY_RUNTIME_BACKEND=auto
ONTOLOGY_SPARQL_ENDPOINT=http://127.0.0.1:3030/ontology/query
ONTOLOGY_SPARQL_TIMEOUT_SECONDS=10
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ROOT_USER=gda_minio
MINIO_ROOT_PASSWORD=__MINIO_PASSWORD__
AWS_ENDPOINT_URL=http://127.0.0.1:9000
AWS_ACCESS_KEY_ID=gda_minio
AWS_SECRET_ACCESS_KEY=__MINIO_PASSWORD__
AWS_S3_BUCKET=gis-agent-uploads
MMFE_LAKEHOUSE_BUCKET=gis-agent-lakehouse
AWS_REGION=us-east-1
LOG_LEVEL=INFO
LOG_FORMAT=json
