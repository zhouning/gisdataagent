  "unsupported_components": [
    {
      "name": "Docker/Compose",
      "status": "excluded",
      "reason": "现场没有容器环境；core/production 使用原生 Windows 安装方式。"
    },
    {
      "name": "Redis",
      "status": "excluded",
      "reason": "不是离线核心链路的必需依赖；任务状态由 DuckDB/文件日志持久化，调度由 Task Scheduler 承担。"
    },
    {
      "name": "DolphinScheduler/Spark/Flink/OpenMetadata",
      "status": "excluded",
      "reason": "当前仓库中的部署形态依赖容器或 Linux；Windows 包不把它们伪装成可用中间件。需要时另行提供受支持的 Linux 节点或现场批准的 Windows 发行版。"
    },
    {
      "name": "cv-service/cad-parser/reference-data",
      "status": "excluded_optional",
      "reason": "Compose 的 qc profile 是独立服务；cv-service 当前依赖 CUDA/Linux 镜像，CAD 和 reference-data 需要单独 API 进程。core/production 的内置 GIS 质检不依赖它们；启用测绘专项质检时应单独验收 Windows CPU 适配包。"
    },
    {
      "name": "Martin vector tile server",
      "status": "excluded_optional",
      "reason": "Compose 的 tiles profile 只用于大规模 PostGIS 矢量瓦片。GIS Data Agent 页面可使用内置 GeoJSON/栅格输出；需要 Martin 时应从批准的 Windows Rust release 作为独立 optional artifact 加入。"
    },
    {
      "name": "AlphaEarth backend/frontend",
      "status": "excluded_out_of_scope",
      "reason": "这是单独的遥感/嵌入演示服务，不是 FileGDB/TIFF 入湖、治理、本体和 Paper9 主链路。"
    }
  ]
