# Host-side paths consumed by docker-compose.gemma4-demo.yml.
# Copy to .env.finals and pass it with: docker compose --env-file .env.finals ...
PAPER9_HOST_REPO=/absolute/path/to/paper9-mnr-offline-package
PAPER9_BISHAN_RUNS_HOST=/absolute/path/to/bishan-runs
PAPER9_DONGXING_RUNS_HOST=/absolute/path/to/dongxing-runs

# Local Qwen through an OpenAI-compatible endpoint. Native development uses
# 127.0.0.1; a containerized app uses host.docker.internal. The air-gapped
# Windows package switches only provider/base URL/model to LM Studio values.
GDA_LLM_PROVIDER=ollama
GDA_LLM_BASE_URL=http://host.docker.internal:11434/v1
GDA_LLM_MODEL=Qwen3.6:27b
GDA_LLM_API_KEY=ollama
GDA_LLM_TIMEOUT_SECONDS=180
MODEL_BACKEND=lm_studio
MODEL_CONFIG_FORCE_ENV=true
MODEL_FAST=Qwen3.6:27b
MODEL_STANDARD=Qwen3.6:27b
MODEL_PREMIUM=Qwen3.6:27b
ROUTER_MODEL=Qwen3.6:27b
NL2SQL_AGENT_MODEL=Qwen3.6:27b
OLLAMA_API_BASE=http://host.docker.internal:11434
EMBEDDING_MODEL=nomic-embed-text-v2-moe
