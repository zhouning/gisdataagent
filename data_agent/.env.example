# ============================================================
# GIS Data Agent v4.0 — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT:
#   - Do NOT use 'export' prefix (python-dotenv handles bare KEY=VALUE)
#   - Use forward slashes in Windows paths (D:/path/to/file)
#   - Do NOT commit .env to version control
# ============================================================

# ==========================
# REQUIRED: Database
# ==========================
# Host-side local Docker Compose profile: the database container is published
# as 127.0.0.1:5433 -> container:5432. Inside Compose, use POSTGRES_HOST=db
# and POSTGRES_PORT=5432 instead. Production NL2SQL must use postgres, not the
# optional DuckDB lite mode.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DATABASE=gis_agent
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=change_me_strong_password
DB_BACKEND=postgres
# GDA_VSOURCE_SECRET_FILE=data_agent/.vsource-secret.env

# Coordinate this server limit with every API/worker replica. The declared
# reserve is larger than PostgreSQL's superuser-only reserve so migrations,
# monitoring, and operational access retain headroom during load spikes.
POSTGRES_MAX_CONNECTIONS=150
POSTGRES_CONNECTION_RESERVE=20
DB_POOL_PROCESS_COUNT=1
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
ASYNC_POOL_MIN=2
ASYNC_POOL_MAX=10

# Full connection URL (auto-built from above if not set; used for Chainlit thread persistence)
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/gis_agent

# OPTIONAL: Plan-bound pgvector projection repair target allowlist. Database
# credentials remain in GDA_CONTROL_DATABASE_URL/DATABASE_URL. Repair callers
# cannot override the registered schema, table, or embedding dimension.
# GDA_VECTOR_PROJECTION_TARGETS_JSON=[{"tenant_id":"local-dev","projection_id":"cq.land_semantic_vectors","target_ref":"vector://db/public.land_semantic_vectors","schema_name":"public","table_name":"land_semantic_vectors","embedding_dimension":1024}]

# OPTIONAL: Durable cross-store projection recovery worker. It resolves only
# registered provider targets. PostGIS/pgvector rebuilds additionally require
# one server-owned JSON row bundle named <plan_sha256>.json in this directory.
# GDA_PROJECTION_RECOVERY_TENANT_ID=chongqing-customer
# GDA_PROJECTION_RECOVERY_WORKER_ID=worker:projection-recovery:node-a
# GDA_PROJECTION_RECOVERY_WORKER_LIMIT=1
# GDA_PROJECTION_RECOVERY_WORKER_LEASE_SECONDS=120
# GDA_PROJECTION_RECOVERY_WORKER_HEARTBEAT_SECONDS=40
# GDA_PROJECTION_RECOVERY_WORKER_RETRY_DELAY_SECONDS=30
# GDA_PROJECTION_RECOVERY_WORKER_POLL_SECONDS=5
# GDA_PROJECTION_RECOVERY_ROWS_DIRECTORY=/app/data_agent/uploads/projection-recovery-rows
# Public governed-query API must resolve tenant-bound live policy and immutable
# audit ports before any query adapter access. Set to 1 in production/staging;
# startup/runtime remains fail-closed until the deployment resolver is wired.
GDA_GOVERNED_QUERY_SECURITY_REQUIRED=0
# Set approved_reapply_sealed_plan only for a worker authorized to consume the
# exact ApprovalCase-bound waiting snapshot. No other strategy value is valid.
# GDA_PROJECTION_RECOVERY_COMPENSATION_STRATEGY=disabled

# OPTIONAL: Plan-bound RDF projection repair target allowlist. Only the
# verified natural-resource-one-map 2.3.0 package is accepted. Configure a
# separately secured writable Graph Store; the bundled ontology-rdf service is
# intentionally read-only.
# GDA_RDF_PROJECTION_TARGETS_JSON=[{"tenant_id":"local-dev","projection_id":"cq.natural_resource_ontology","target_ref":"rdf://fuseki-writer/ontology/default","graph_store_endpoint":"http://fuseki-writer.internal:3030/ontology/data?default","package_dir":"/app/data_agent/ontology/packages/natural_resource_one_map/2.3.0","ontology_key":"natural-resource-one-map","semantic_version":"2.3.0","package_id":"natural-resource-one-map:2.3.0:587915868b1221af","package_content_sha256":"587915868b1221af2315508ede7bf7babced063cba8b261de2f10afa23841019","rdf_artifact_sha256":"7d709b1c3d03ab9b73e2413e9cf085d5730dbc1380eb9f8f0671b47eea911b27","expected_triple_count":537245}]
# GDA_RDF_PROJECTION_USERNAME=workload_identity
# GDA_RDF_PROJECTION_PASSWORD=from_secret_manager
# GDA_RDF_PROJECTION_TIMEOUT_SECONDS=120

# OPTIONAL: Plan-bound S3 object projection repair allowlist. This binds only
# the Chongqing customer artifact and natural-resource-one-map 2.3.0. Keep the
# registry and credentials server-side; requests carry only a sealed plan.
# GDA_OBJECT_PROJECTION_TARGETS_JSON=[{"tenant_id":"local-dev","projection_id":"cq.customer.heping_changed_parcels","target_ref":"s3://gis-agent-uploads/natural-resource-ontology-customer-demo-v1/heping_changed_parcels.geojson","endpoint_url":"http://minio:9000","region_name":"us-east-1","bucket":"gis-agent-uploads","key":"natural-resource-ontology-customer-demo-v1/heping_changed_parcels.geojson","bundle_manifest_path":"/app/data_agent/demo_data/natural_resource_ontology_customer_v1/manifest.json","bundle_manifest_sha256":"3fa52914ee6ce87e77c498adaba68b32a1d5206fa31ad4bd59e56e43bcc74531","bundle_id":"natural-resource-ontology-customer-demo-v1","bundle_version":"1.0.0","artifact_path":"/app/data_agent/demo_data/natural_resource_ontology_customer_v1/heping_changed_parcels.geojson","artifact_name":"heping_changed_parcels.geojson","artifact_sha256":"eb35068c4273fe25e07d99f822016f33b6fe29cd189b34aff037b9611e163bd3","artifact_size_bytes":1950576,"media_type":"application/geo+json","ontology_package_id":"natural-resource-one-map:2.3.0:587915868b1221af","ontology_package_content_sha256":"587915868b1221af2315508ede7bf7babced063cba8b261de2f10afa23841019"}]
# GDA_OBJECT_PROJECTION_ACCESS_KEY_ID=from_secret_manager
# GDA_OBJECT_PROJECTION_SECRET_ACCESS_KEY=from_secret_manager
# GDA_OBJECT_PROJECTION_SESSION_TOKEN=
# GDA_OBJECT_PROJECTION_TIMEOUT_SECONDS=120

# OPTIONAL: Plan-bound Spark/Iceberg lakehouse repair allowlist. This example
# binds only the normalized 445-feature Chongqing artifact and ontology 2.3.0.
# GDA_LAKEHOUSE_PROJECTION_TARGETS_JSON=[{"tenant_id":"local-dev","projection_id":"cq.customer.heping_changed_parcels_lakehouse","target_ref":"iceberg://lakehouse/cq_customer/heping_changed_parcels","catalog":"lakehouse","namespace":"cq_customer","table":"heping_changed_parcels","warehouse_uri":"s3://gis-agent-lakehouse/warehouse/projections/cq_customer","endpoint_url":"http://minio:9000","region_name":"us-east-1","bucket":"gis-agent-lakehouse","bundle_manifest_path":"/app/data_agent/demo_data/natural_resource_ontology_customer_v1/manifest.json","bundle_manifest_sha256":"3fa52914ee6ce87e77c498adaba68b32a1d5206fa31ad4bd59e56e43bcc74531","bundle_id":"natural-resource-ontology-customer-demo-v1","bundle_version":"1.0.0","artifact_path":"/app/data_agent/demo_data/natural_resource_ontology_customer_v1/heping_changed_parcels.geojson","artifact_name":"heping_changed_parcels.geojson","artifact_sha256":"eb35068c4273fe25e07d99f822016f33b6fe29cd189b34aff037b9611e163bd3","artifact_size_bytes":1950576,"expected_table_content_sha256":"8d5339abfd8b7015e894791f3198cbe3f097470a9292b6e019f9ceb030e46dfb","expected_row_count":445,"ontology_package_id":"natural-resource-one-map:2.3.0:587915868b1221af","ontology_package_content_sha256":"587915868b1221af2315508ede7bf7babced063cba8b261de2f10afa23841019"}]
# GDA_LAKEHOUSE_PROJECTION_ACCESS_KEY_ID=from_secret_manager
# GDA_LAKEHOUSE_PROJECTION_SECRET_ACCESS_KEY=from_secret_manager
# GDA_LAKEHOUSE_PROJECTION_SESSION_TOKEN=
# GDA_LAKEHOUSE_PROJECTION_SPARK_IMAGE=gisdataagent/mmfe-spark-runtime:local
# GDA_LAKEHOUSE_PROJECTION_DOCKER_NETWORK=gisdataagent_agent-net
# GDA_LAKEHOUSE_PROJECTION_REPOSITORY_ROOT=/app
# GDA_LAKEHOUSE_PROJECTION_JAVA_HOME=/usr/lib/jvm/java-17-openjdk-arm64
# GDA_LAKEHOUSE_PROJECTION_TIMEOUT_SECONDS=600

# OPTIONAL: Deployment-owned customer approval trust roots. Requests may carry
# signed evidence but must never submit or override this registry. Store public
# key fingerprints only; never put customer private keys in environment config.
# GDA_CUSTOMER_COMPENSATION_APPROVAL_TRUST_REGISTRY_JSON=[{"tenant_id":"local-dev","customer_authority_ref":"customer-authority:example","signature_key_id":"customer-key-ed25519","signature_algorithm":"ed25519","public_key_sha256":"<64 lowercase hex chars>","valid_from":"<RFC3339 UTC>","valid_until":"<RFC3339 UTC>","status":"active","anchor_sha256":"<computed anchor fingerprint>"}]

# ==========================
# REQUIRED: AI Model
# ==========================
# Local air-gapped model (recommended for this project). Both Ollama and LM
# Studio expose OpenAI-compatible Chat Completions. GDA_LLM_BASE_URL is the
# API root; do not append /chat/completions. A mistakenly pasted full endpoint
# is normalized by the application.
#
# Developer machine / Ollama:
# GDA_LLM_PROVIDER=ollama
# GDA_LLM_BASE_URL=http://127.0.0.1:11434/v1
# GDA_LLM_MODEL=Qwen3.6:27b
# GDA_LLM_API_KEY=ollama
#
# Air-gapped Windows / LM Studio:
# GDA_LLM_PROVIDER=lm_studio
# GDA_LLM_BASE_URL=http://127.0.0.1:1234/v1
# GDA_LLM_MODEL=<model identifier shown by LM Studio Local Server>
# GDA_LLM_API_KEY=lm-studio
#
# Use the same local model throughout GIS Data Agent. MODEL_BACKEND retains
# the historical name "lm_studio" but means any local OpenAI-compatible API.
# MODEL_BACKEND=lm_studio
# MODEL_CONFIG_FORCE_ENV=true
# MODEL_FAST=Qwen3.6:27b
# MODEL_STANDARD=Qwen3.6:27b
# MODEL_PREMIUM=Qwen3.6:27b
# ROUTER_MODEL=Qwen3.6:27b
# NL2SQL_AGENT_MODEL=Qwen3.6:27b
# NL2SQL_AGENT_FAMILY=qwen
# GDA_LLM_TIMEOUT_SECONDS=180
# GIS workflow planning calls the configured model by default. Disable only
# when an installation deliberately requires deterministic fallback parsing.
# GDA_GIS_WORKFLOW_LLM_ENABLED=true
# Optional dedicated model; otherwise ROUTER_MODEL, then GDA_LLM_MODEL is used.
# GDA_GIS_WORKFLOW_PLANNER_MODEL=Qwen3.6:27b

# Online DeepSeek Responses API (requires a real key; never commit it).
# The official Responses API currently supports deepseek-v4-flash and uses
# the API root without /v1. The application requests /responses itself.
# GDA_LLM_PROVIDER=deepseek
# GDA_LLM_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=sk-...                     # keep this only in local .env
# GDA_LLM_MODEL=deepseek-v4-flash
# NL2SQL_AGENT_MODEL=deepseek-v4-flash
# NL2SQL_AGENT_FAMILY=deepseek
# GDA_LLM_API_STYLE=responses
# GDA_DEEPSEEK_REASONING_EFFORT=low
# GDA_NL2SQL_MAX_OUTPUT_TOKENS=8192

# Online OpenAI GPT through ADK's LiteLLM connector.
# GPT-5.6 models support tool calling, structured output, image input, and
# both Chat Completions and Responses. ADK's LiteLlm path uses Chat Completions
# so it can participate in the existing tool-calling agent loops.
# OPENAI_API_KEY=sk-...                    # keep only in the local ignored .env
# GDA_LLM_PROVIDER=openai
# GDA_LLM_BASE_URL=https://api.openai.com/v1
# GDA_LLM_API_KEY=                          # optional; OPENAI_API_KEY is preferred
# GDA_LLM_MODEL=gpt-5.6-terra               # direct helper/NL2SQL fallback
# MODEL_BACKEND=openai
# MODEL_CONFIG_FORCE_ENV=true
# MODEL_FAST=gpt-5.6-luna
# MODEL_STANDARD=gpt-5.6-terra
# MODEL_PREMIUM=gpt-5.6-sol
# ROUTER_MODEL=gpt-5.6-luna
# NL2SQL_AGENT_MODEL=gpt-5.6-terra
# NL2SQL_AGENT_FAMILY=openai
# GDA_OPENAI_REASONING_EFFORT=low           # none|low|medium|high|xhigh|max
# GDA_LLM_TIMEOUT_SECONDS=180

# Online Gemini through Google's OpenAI-compatible API.
# GEMINI_API_KEY=<keep only in local ignored .env>
# Use the native Google API directly. Set ``openai_compatible`` only when a
# deployment intentionally provides a Gemini-compatible gateway.
GDA_GEMINI_TRANSPORT=direct
# GDA_LLM_PROVIDER=gemini
# GDA_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GDA_LLM_MODEL=gemini-3.6-flash
# NL2SQL_AGENT_MODEL=gemini-3.6-flash
# NL2SQL_AGENT_FAMILY=gemini
# GDA_LLM_API_STYLE=chat
# GDA_GEMINI_REASONING_EFFORT=low
# GDA_NL2SQL_MAX_OUTPUT_TOKENS=8192
# GDA_LLM_TIMEOUT_SECONDS=180

# Online Qwen through Alibaba Cloud Model Studio / DashScope compatible mode.
# Keep the real key only in the local ignored .env file. Disabling thinking
# matches the local Ollama Qwen benchmark's think=false evaluation profile.
# GDA_LLM_PROVIDER=openai_compatible
# GDA_LLM_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# GDA_LLM_API_KEY=sk-...
# GDA_LLM_MODEL=qwen3.8-max
# NL2SQL_AGENT_MODEL=qwen3.8-max
# NL2SQL_AGENT_FAMILY=qwen
# GDA_LLM_API_STYLE=chat
# GDA_LLM_ENABLE_THINKING=0
# GDA_NL2SQL_MAX_OUTPUT_TOKENS=8192

# Option A: Vertex AI (explicit online opt-in only)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Option B: Google AI Studio API Key (simpler setup)
# GOOGLE_GENAI_USE_VERTEXAI=0
# GOOGLE_API_KEY=AIzaSy...your_api_key

# Option C: Embedding model selection
# - text-embedding-004: Google Vertex AI embedding (online)
# - bge-m3: sentence-transformers local model
# - nomic-embed-text-v2-moe: local Ollama embedding model (recommended offline)
# - text-embedding-nomic-embed-text-v2-moe: LM Studio/OpenAI-compatible model
#
# Developer machine / Ollama:
# EMBEDDING_MODEL=nomic-embed-text-v2-moe
# GDA_EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest
# GDA_EMBEDDING_PROVIDER=ollama
# GDA_EMBEDDING_BASE_URL=http://127.0.0.1:11434
# GDA_EMBEDDING_API_KEY=ollama
#
# Air-gapped Windows / LM Studio. The model ID must match /v1/models exactly:
# EMBEDDING_MODEL=text-embedding-nomic-embed-text-v2-moe
# GDA_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v2-moe
# GDA_EMBEDDING_PROVIDER=lm_studio
# GDA_EMBEDDING_BASE_URL=http://10.64.4.202:1234/v1
# GDA_EMBEDDING_API_KEY=lm-studio
# EMBEDDING_DIMENSION=768
#
# If chat and embeddings are served by the same LM Studio instance,
# GDA_EMBEDDING_BASE_URL may be omitted and GDA_LLM_BASE_URL is reused.
EMBEDDING_MODEL=nomic-embed-text-v2-moe

# Keep few-shot examples inside the resolved semantic domain by default.
# Enable only after cross-domain examples have been reviewed for relation-role
# and SQL-dialect compatibility.
GDA_NL2SQL_ALLOW_CROSS_DOMAIN_FEWSHOT=0

# ==========================
# Generate with: chainlit create-secret
CHAINLIT_AUTH_SECRET=your_random_secret_key_here
# Dedicated HMAC key for GIS semantic Proposal attestations. Keep identical
# across all API/worker replicas; rotate it with a planned Proposal invalidation.
GDA_GIS_WORKFLOW_ATTESTATION_SECRET=replace_with_a_long_random_gis_key

# ==========================
# OPTIONAL: OAuth2 Login
# ==========================
# Uncomment to enable "Sign in with Google" button
# OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
# OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==========================
# OPTIONAL: Agent Behavior
# ==========================
# Dynamic planner uses transfer_to_agent; false = fixed SequentialAgent pipelines
DYNAMIC_PLANNER=true

# ==========================
# OPTIONAL: NL2SQL execution engine
# ==========================
# PostGIS is the production default. Set to lake only when governed GeoParquet
# projections and the matching DuckDB Spatial extension are available.
GDA_NL2SQL_EXECUTION_ENGINE=postgis
# Legacy Chongqing bridge/building/POI map demo plugin. Keep disabled for
# production arbitrary-data deployments; enable only for the labeled demo.
GDA_NL2SQL_DEMO_MAPS=0
# For the parallel lake route, point this at the governed catalog.json. The
# request-scoped catalog ContextVar can override it for multi-tenant APIs.
# GDA_OFFLINE_SEMANTIC_CATALOG=D:/GDA/file_lake/semantic_products/catalog.json
# Local Qwen uses the paper's embedding-based few-shot retrieval by default.
# Set to 0 only when no local embedding service is available. Retrieval is
# non-fatal and will be empty when the configured service is unreachable.
# GDA_NL2SQL_LOCAL_FEWSHOT=1
# GDA_NL2SQL_FEWSHOT_MIN_SCORE=0.35
# GDA_NL2SQL_AUTO_CURATE_LOCAL=1
# SQL 生成服务发生瞬时错误时的调用重试次数。旧变量
# NL2SQL_GEMMA_SQL_RETRIES 仍兼容，但新部署应使用模型无关名称。
# GDA_NL2SQL_GENERATION_RETRIES=3
# GDA_NL2SQL_ONLINE_RETRY_BASE_SECONDS=5
# GDA_NL2SQL_ONLINE_RETRY_MAX_SECONDS=60
# GDA_NL2SQL_BENCH_REQUEST_INTERVAL_SECONDS=2
# 默认禁止模型在 grounding 之外自行引入物理表。仅用于诊断时开启。
# GDA_NL2SQL_ALLOW_SQL_REFERENCED_TABLES=0
# DLTB semantic publication writes versioned tables and atomically switches
# this stable view; both SQL engines remain bound to the same GeoParquet hash.
# GDA_DLTB_POSTGIS_SCHEMA=public
# GDA_POSTGIS_PUBLISH_CHUNKSIZE=5000
# Windows offline bundle resolves this path automatically from GDA_DUCKDB_PATH.
# GDA_DUCKDB_SPATIAL_EXTENSION_PATH=D:/GDA/payload/middleware/duckdb/extensions/spatial.duckdb_extension
# Managed Blueprint DuckDB worker. Local mode requires a shared API/worker path.
# S3/MinIO mode uses this only as a private ephemeral worker workspace.
# GDA_BLUEPRINT_DUCKDB_RESULT_BACKEND=local
# GDA_BLUEPRINT_DUCKDB_OUTPUT_ROOT=D:/GDA_DATA/blueprint-duckdb-results
# GDA_BLUEPRINT_DUCKDB_RESULT_BACKEND=s3
# GDA_BLUEPRINT_DUCKDB_OUTPUT_S3_BUCKET=gis-agent-blueprint-results
# GDA_BLUEPRINT_DUCKDB_OUTPUT_S3_PREFIX=blueprint-duckdb-results/v1
# GDA_BLUEPRINT_DUCKDB_INPUT_S3_PREFIXES=s3://gis-agent-lakehouse/products
# GDA_BLUEPRINT_DUCKDB_ACCESS_KEY_ID=gda_blueprint_worker
# GDA_BLUEPRINT_DUCKDB_SECRET_ACCESS_KEY=replace_with_worker_only_secret
# GDA_BLUEPRINT_DUCKDB_TENANT_ID=planning
# GDA_BLUEPRINT_DUCKDB_WORKER_ID=worker:blueprint-duckdb:node-1
# GDA_BLUEPRINT_DUCKDB_BATCH_SIZE=1
# GDA_BLUEPRINT_DUCKDB_LEASE_SECONDS=900
# GDA_BLUEPRINT_DUCKDB_TIMEOUT_CEILING_SECONDS=600
# GDA_BLUEPRINT_DUCKDB_IO_BUDGET_SECONDS=240
# GDA_BLUEPRINT_DUCKDB_S3_CONNECT_TIMEOUT_SECONDS=5
# GDA_BLUEPRINT_DUCKDB_S3_READ_TIMEOUT_SECONDS=60
# GDA_BLUEPRINT_DUCKDB_RETRY_SECONDS=30
# GDA_BLUEPRINT_DUCKDB_POLL_SECONDS=5
# GDA_BLUEPRINT_DUCKDB_STATUS_FILE=D:/GDA_DATA/status/duckdb-blueprint-worker.json
# GDA_BLUEPRINT_DUCKDB_HEALTH_MAX_AGE_SECONDS=1200
# GDA_BLUEPRINT_DUCKDB_SPATIAL_EXTENSION_PATH=D:/GDA/payload/middleware/duckdb/extensions/spatial.duckdb_extension

# Managed Martin provider-origin warmup worker. The S3/MinIO profile requires
# bucket versioning plus Object Lock default retention and records exact
# VersionId/ETag evidence. Credentials use the standard AWS SDK chain; do not
# put them in Run, Artifact, receipt, or worker status configuration.
# GDA_GIS_WARMUP_TENANT_ID=planning
# GDA_GIS_WARMUP_WORKER_ID=worker:gis-warmup:node-1
# GDA_GIS_WARMUP_MARTIN_ORIGIN_URI=http://martin:3000
# Governed OGC API Features route provider origin. Empty means disabled.
# PYGEOAPI_URL=http://pygeoapi:80
# PYGEOAPI_PROVIDER_VERSION=0.25.dev0
# GDA_GIS_WARMUP_RECEIPT_BACKEND=local
# GDA_GIS_WARMUP_RECEIPT_ROOT=D:/GDA_DATA/gis-warmup-receipts
# GDA_GIS_WARMUP_RECEIPT_BACKEND=s3
# GDA_GIS_WARMUP_S3_BUCKET=gis-agent-evidence
# GDA_GIS_WARMUP_S3_PREFIX=gis-warmup-receipts/v1
# GDA_GIS_WARMUP_S3_CONNECT_TIMEOUT_SECONDS=5
# GDA_GIS_WARMUP_S3_READ_TIMEOUT_SECONDS=60
# GDA_GIS_WARMUP_PROVIDER_TIMEOUT_SECONDS=10
# GDA_GIS_WARMUP_BATCH_SIZE=1
# GDA_GIS_WARMUP_LEASE_SECONDS=1500
# GDA_GIS_WARMUP_RETRY_DELAY_SECONDS=30
# GDA_GIS_WARMUP_POLL_INTERVAL_SECONDS=5
# GDA_GIS_WARMUP_STATUS_FILE=D:/GDA_DATA/status/gis-warmup-worker.json

# Gateway-side shared MVT response cache. The route authorizes and audits each
# request before Redis; Redis failure falls back to private Martin.
# GDA_GIS_MVT_CACHE_REDIS_URL=redis://localhost:6379/1
# GDA_GIS_MVT_CACHE_KEY_PREFIX=gda:mvt:response:v1
# GDA_GIS_MVT_CACHE_MAX_OBJECT_BYTES=1048576
# GDA_GIS_MVT_CACHE_TIMEOUT_SECONDS=0.5
# Asynchronous retired-generation cleanup worker (cutover/rollback outbox).
# GDA_GIS_MVT_CACHE_PURGE_TENANT_ID=planning
# GDA_GIS_MVT_CACHE_PURGE_WORKER_ID=worker:gis-mvt-cache-purge:node-1
# GDA_GIS_MVT_CACHE_PURGE_BATCH_SIZE=10
# GDA_GIS_MVT_CACHE_PURGE_LEASE_SECONDS=60
# GDA_GIS_MVT_CACHE_PURGE_RETRY_SECONDS=30
# GDA_GIS_MVT_CACHE_PURGE_POLL_SECONDS=5
# GDA_GIS_MVT_CACHE_PURGE_MAX_KEYS=10000
# GDA_GIS_MVT_CACHE_PURGE_SCAN_COUNT=100
# Explicit provider selection; redis remains the default. HTTP uses a
# credential-free endpoint and an optional mounted 0600 bearer token file.
# GDA_GIS_MVT_CACHE_PURGE_PROVIDER=redis
# GDA_GIS_MVT_CACHE_PURGE_HTTP_ENDPOINT_URL=
# GDA_GIS_MVT_CACHE_PURGE_HTTP_BEARER_TOKEN_FILE=
# GDA_GIS_MVT_CACHE_PURGE_HTTP_TIMEOUT_SECONDS=5

# ==========================
# OPTIONAL: Governed GIS analysis command worker
# ==========================
# The execution and cancellation URLs must be different owner-only (0600)
# secret files and must authenticate as different PostgreSQL roles. The
# execution role must not inherit pg_signal_backend. The non-superuser
# cancellation role must inherit pg_signal_backend and no platform gateway role.
# GDA_GIS_ANALYSIS_TENANT_ID=planning
# GDA_GIS_ANALYSIS_WORKER_ID=worker:gis-analysis-postgis:node-1
# GDA_GIS_ANALYSIS_POSTGIS_DATABASE_URL_FILE=/run/secrets/gis-analysis-postgis-url
# GDA_GIS_ANALYSIS_POSTGIS_DATABASE_ROLE=gis_analysis_reader
# GDA_GIS_ANALYSIS_POSTGIS_CANCELLER_DATABASE_URL_FILE=/run/secrets/gis-analysis-canceller-url
# GDA_GIS_ANALYSIS_POSTGIS_CANCELLER_DATABASE_ROLE=gis_analysis_canceller
# GDA_GIS_ANALYSIS_RESULT_BACKEND=local
# GDA_GIS_ANALYSIS_RESULT_ROOT=/var/lib/gda/gis-analysis-results
# For immutable S3 results, use backend=s3 and omit RESULT_ROOT.
# GDA_GIS_ANALYSIS_RESULT_S3_BUCKET=gis-analysis-results
# GDA_GIS_ANALYSIS_RESULT_S3_PREFIX=gis-analysis-results/v1
# GDA_GIS_ANALYSIS_RESULT_STORE_TIMEOUT_SECONDS=10
# GDA_GIS_ANALYSIS_POSTGIS_CONNECT_TIMEOUT_SECONDS=5
# GDA_GIS_ANALYSIS_POSTGIS_STATEMENT_TIMEOUT_CEILING_MS=30000
# GDA_GIS_ANALYSIS_BATCH_SIZE=10
# GDA_GIS_ANALYSIS_LEASE_SECONDS=120
# GDA_GIS_ANALYSIS_POLL_INTERVAL_SECONDS=5
# GDA_GIS_ANALYSIS_CANCEL_POLL_INTERVAL_SECONDS=0.5
# GDA_GIS_ANALYSIS_CANCEL_LEASE_SECONDS=30
# GDA_GIS_ANALYSIS_CANCEL_RECEIPT_WAIT_SECONDS=5
# GDA_GIS_ANALYSIS_RECONCILIATION_POLL_INTERVAL_SECONDS=5
# GDA_GIS_ANALYSIS_RECONCILIATION_LEASE_SECONDS=30
# GDA_GIS_ANALYSIS_STATUS_FILE=/tmp/gda-gis-analysis-command-worker.json
# GDA_GIS_ANALYSIS_HEALTH_MAX_AGE_SECONDS=180

# ==========================
# OPTIONAL: Map Services
# ==========================
# Gaode Maps (高德) — geocoding & reverse geocoding
# GAODE_API_KEY=your_gaode_api_key

# Tianditu (天地图) — basemap tiles (Vec + Img)
# TIANDITU_TOKEN=your_tianditu_token

# ==========================
# OPTIONAL: Cloud Storage
# ==========================
# Huawei Cloud OBS (S3-compatible)
# HUAWEI_OBS_AK=your_access_key
# HUAWEI_OBS_SK=your_secret_key
# HUAWEI_OBS_SERVER=https://obs.cn-north-4.myhuaweicloud.com
# HUAWEI_OBS_BUCKET=your_bucket_name

# AWS S3
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your_bucket_name

# Google Cloud Storage
# GCS_BUCKET=your_bucket_name

# ==========================
# OPTIONAL: Enterprise Bots
# ==========================
# WeChat Work (企业微信)
# WECOM_CORP_ID=your_corp_id
# WECOM_APP_SECRET=your_app_secret
# WECOM_TOKEN=your_callback_token
# WECOM_ENCODING_AES_KEY=your_aes_key
# WECOM_AGENT_ID=1000002
# WECOM_SHARE_BASE_URL=https://your-domain.com

# DingTalk (钉钉)
# DINGTALK_APP_KEY=your_app_key
# DINGTALK_APP_SECRET=your_app_secret
# DINGTALK_ROBOT_CODE=your_robot_code
# DINGTALK_SHARE_BASE_URL=https://your-domain.com

# Feishu / Lark (飞书)
# FEISHU_APP_ID=your_app_id
# FEISHU_APP_SECRET=your_app_secret
# FEISHU_VERIFICATION_TOKEN=your_verification_token
# FEISHU_ENCRYPT_KEY=your_encrypt_key
# FEISHU_SHARE_BASE_URL=https://your-domain.com

# ==========================
# OPTIONAL: Redis (Real-time Streams)
# ==========================
# Falls back to in-memory if not configured
# REDIS_URL=redis://localhost:6379/0

# ==========================
# OPTIONAL: Observability
# ==========================
# LOG_LEVEL=INFO
# LOG_FORMAT=text
# AUDIT_LOG_RETENTION_DAYS=90

# ==========================
# AgentOps Temporal reconciler specialist authorities
# ==========================
# The managed reconciler requires PostgreSQL (DATABASE_URL), migration 246, and
# an explicit immutable content backend.  It never falls back to in-memory
# receipts when provider-bound MMFE/GWM activities are observed.
# GDA_AGENTOPS_RECONCILER_SPECIALIST_ARTIFACT_BACKEND=s3
# GDA_AGENTOPS_RECONCILER_SPECIALIST_MATERIALIZATION_ROOT=/var/lib/gda-agentops/reconciler/materialized
# For local/disposable runs only:
# GDA_AGENTOPS_RECONCILER_SPECIALIST_ARTIFACT_BACKEND=filesystem
# GDA_AGENTOPS_RECONCILER_SPECIALIST_ARTIFACT_ROOT=/var/lib/gda-agentops/reconciler/content
# For S3/MinIO, bucket versioning is mandatory so Artifact reads remain immutable:
# GDA_AGENTOPS_RECONCILER_SPECIALIST_S3_ENDPOINT=http://minio:9000
# GDA_AGENTOPS_RECONCILER_SPECIALIST_S3_BUCKET=gis-agent-evidence
# GDA_AGENTOPS_RECONCILER_SPECIALIST_S3_PREFIX=agentops-specialist/v1
# GDA_AGENTOPS_RECONCILER_SPECIALIST_S3_REGION=us-east-1
# GDA_AGENTOPS_RECONCILER_SPECIALIST_S3_REQUIRE_VERSION_ID=true
# Object Lock with positive default retention is mandatory for the production S3/MinIO backend.
# GDA_AGENTOPS_RECONCILER_SPECIALIST_S3_REQUIRE_OBJECT_LOCK_RETENTION=true
# GDA_AGENTOPS_RECONCILER_SPECIALIST_S3_ADDRESSING_STYLE=path
# Optional workload-scoped credentials (otherwise use the runtime credential chain):
# GDA_AGENTOPS_RECONCILER_SPECIALIST_S3_ACCESS_KEY_ID=
# GDA_AGENTOPS_RECONCILER_SPECIALIST_S3_SECRET_ACCESS_KEY=
# GDA_AGENTOPS_RECONCILER_SPECIALIST_RECORDED_BY=workload:agentops-specialist-reconciler

# ConsumerBinding migration notification worker
# GDA_CONSUMER_BINDING_NOTIFICATION_TENANT_ID=planning
# GDA_CONSUMER_BINDING_NOTIFICATION_WORKER_ID=worker:consumer-binding-alertmanager:node-1
# GDA_CONSUMER_BINDING_NOTIFICATION_RECORDED_BY=service:consumer-binding-notification-worker
# GDA_ALERTMANAGER_URL=http://alertmanager.monitoring.svc:9093
# GDA_ALERTMANAGER_BEARER_TOKEN_FILE=/run/secrets/alertmanager-token
# GDA_CONSUMER_BINDING_NOTIFICATION_BATCH_SIZE=10
# GDA_CONSUMER_BINDING_NOTIFICATION_LEASE_SECONDS=60
# GDA_CONSUMER_BINDING_NOTIFICATION_RETRY_SECONDS=30
# GDA_CONSUMER_BINDING_NOTIFICATION_POLL_SECONDS=5
# GDA_CONSUMER_BINDING_NOTIFICATION_METRICS_PORT=9469
# GDA_CONSUMER_BINDING_NOTIFICATION_ROUTE_NAMESPACE=gis-data-agent

# ==========================
# OPTIONAL: Human-in-the-Loop (HITL)
# ==========================
# Enable/disable HITL approval for high-risk tool calls
# HITL_ENABLED=true
# Minimum risk level that triggers blocking approval: critical | high | medium
# HITL_BLOCK_LEVEL=critical
# Timeout in seconds for user to respond to approval dialog
# HITL_TIMEOUT=120

# ==========================
# OPTIONAL: Usage Limits
# ==========================
# DAILY_ANALYSIS_LIMIT=20
# MONTHLY_TOKEN_LIMIT=0

# ==========================
# OPTIONAL: Offline FileGDB ZIP Ingest
# ==========================
# Browser uploads use durable chunks; FileGDB must be packaged as ZIP.
# GDA_FILE_LAKE_ROOT=D:/GDA_FILE_LAKE
# GDA_LOCAL_INGEST_DIRS=D:/NX_INCOMING;E:/NX_REMOVABLE
# GDA_ARCHIVE_MAX_FILES=200000
# GDA_ARCHIVE_MAX_ENTRIES=250000
# GDA_ARCHIVE_MAX_UNCOMPRESSED_BYTES=2199023255552
# GDA_ARCHIVE_MAX_FILE_BYTES=549755813888
# GDA_ARCHIVE_MAX_COMPRESSION_RATIO=1000
# GDA_ARCHIVE_DISK_RESERVE_BYTES=536870912

# ==========================
# OPTIONAL: CostGuard
# ==========================
# Token warning threshold per pipeline run
# COST_GUARD_WARN=50000
# Token abort threshold per pipeline run
# COST_GUARD_ABORT=200000
# USD abort threshold per pipeline run (0 = disabled)
# COST_GUARD_USD_ABORT=0
# ==========================
# OPTIONAL: Extensions
# ==========================
# ArcPy Integration (use forward slashes!)
# ARCPY_PYTHON_EXE=D:/path/to/arcgis/python.exe

# MCP Toolbox
# MCP_TOOLBOX_URL=http://localhost:8080

# Private remote MCP servers
# Inject real values through the local environment or an untracked .env file.
# Never commit bearer tokens.
# ARCPY_MCP_TOKEN=
# DTS_MCP_TOKEN=
# MCP_CLOSE_TIMEOUT=5

# Google Earth Engine
# GEE_SERVICE_ACCOUNT_KEY=path/to/key.json
