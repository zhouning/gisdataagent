gda:ClassConceptShape a sh:NodeShape ;
    sh:property [ sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dcterms:identifier ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path skos:prefLabel ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path prov:wasDerivedFrom ] ;
    sh:targetClass owl:Class .

gda:ValueDomainShape a sh:NodeShape ;
    sh:property [ sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path skos:prefLabel ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path prov:wasDerivedFrom ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dcterms:identifier ] ;
    sh:targetClass skos:ConceptScheme .

gda:ValueMemberShape a sh:NodeShape ;
    sh:property [ sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path dcterms:identifier ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path skos:prefLabel ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path prov:wasDerivedFrom ] ;
    sh:targetClass skos:Concept .

