# Copy to data_agent/.env for a Windows physical-isolation installation.
# Paths may use drive letters, e.g. D:\\GDA_FILE_LAKE.
GDA_FILE_LAKE_ROOT=D:\\GDA_FILE_LAKE
GDA_FILE_LAKE_INBOX=D:\\NX_INCOMING
GDA_LOCAL_INGEST_DIRS=D:\\NX_INCOMING;E:\\NX_REMOVABLE
GDA_OFFLINE_INGEST_AUTH_REQUIRED=true
CHAINLIT_AUTH_SECRET=replace-with-a-long-random-secret
# Workbook-derived contracts are candidate evidence only.  Runtime prefers
# this versioned JSON contract; the workbook is used only as bootstrap fallback.
GDA_STANDARD_CONTRACTS=D:\\GDA_CONFIG\\natural_resource_standard_contracts.json
# Optional discovery evidence for candidate matching during contract review:
# GDA_STANDARD_CONTRACT_XLSX=D:\\GDA_CONFIG\\SHP矢量数据表及字段梳理_追加更新版.xlsx
GDA_DATA_INVENTORY_XLSX=D:\\GDA_CONFIG\\提供数据内容详细梳理分析20260716.xlsx
GDA_NATURAL_RESOURCE_STANDARD_VERSION=NX-2026-baseline
# GIS Data Agent bundles pyogrio/geopandas/rasterio and does not require
# ArcPy, ArcGIS Pro, MCP or external GDAL executables. The following are
# optional accelerators only when the site has deliberately installed them.
# GDA_OGRINFO_PATH=D:\\GDA_TOOLS\\gdal\\ogrinfo.exe
# GDA_OGR2OGR_PATH=D:\\GDA_TOOLS\\gdal\\ogr2ogr.exe
# GDA_GDAL_TRANSLATE_PATH=D:\\GDA_TOOLS\\gdal\\gdal_translate.exe
GDA_STANDARDIZED_VECTOR_FORMAT=Parquet
# Set only on a protected host when database materialization is enabled.
# GDA_POSTGIS_DSN=PG:host=127.0.0.1 dbname=natural_resources user=gda
GDA_LOG_DIR=D:\\GDA_LOGS
GDA_LOG_ROTATION_MB=50
GDA_LOG_BACKUP_COUNT=14
GDA_INGEST_SETTLE_SECONDS=60
GDA_DIAGNOSTIC_RETENTION_DAYS=365
LOG_LEVEL=INFO
LOG_FORMAT=json
