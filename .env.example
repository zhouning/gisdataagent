# =============================================================================
# GIS Data Agent — Environment Variables
# Copy this file to data_agent/.env and fill in your values.
# Lines use 'export' prefix (bash-style) for compatibility.
# =============================================================================

# --- PostgreSQL / PostGIS (required) -----------------------------------------
# Default is the local multi-arch PostGIS + pgvector image. Build it with:
#   docker build -t gis-postgis-pgvector:16-3.4 docker/postgis-pgvector
export POSTGIS_IMAGE="gis-postgis-pgvector:16-3.4"
export POSTGRES_HOST="db"                    # Docker service name or external host
export POSTGRES_PORT="5432"
export POSTGRES_DATABASE="gis_agent"
export POSTGRES_USER="agent_user"
export POSTGRES_PASSWORD="change_me_strong_password"

# --- ArcGIS data ingestion --------------------------------------------------
# Host development may keep the embedded worker enabled. Docker/Kubernetes use
# a dedicated worker and override this to 0 in the application container.
export GDA_INGEST_EMBEDDED_WORKER="1"
# Local sandbox interval polling. Production sets this to external so
# DolphinScheduler owns schedules, backfills, resource queues, and alerts.
export GDA_INGEST_SCHEDULE_DRIVER="internal" # internal | external
export GDA_INGEST_LAKE_BACKEND="local" # local | cloud
export GDA_INGEST_LAKE_ROOT="data_agent/data_lake/raw"
export GDA_INGEST_LAKE_BUCKET="gis-agent-lakehouse"
export GDA_INGEST_LAKE_PREFIX="lakehouse/raw"
export GDA_INGEST_PLATFORM_BRIDGE="1"

# Governed DataOps manual admission. Bind these identities to OIDC/workload
# federation in production; they are not credentials and must not contain tokens.
export GDA_DATAOPS_MANUAL_WORKLOAD_SUBJECT="workload:dolphinscheduler-gda-dataops"
export GDA_DATAOPS_MANUAL_WORKLOAD_ROLES="platform_operator"
export GDA_DATAOPS_MANUAL_POLICY_VERSION_REF="gda://local-dev/policy/jqdltb-manual-sandbox:v1"
export GDA_DATAOPS_MANUAL_POLICY_EVALUATOR_SUBJECT="workload:gda-policy-evaluator"
export GDA_DATAOPS_MANUAL_POLICY_TTL_SECONDS="86400"
export GDA_DATAOPS_MANUAL_INVOCATION_OWNER_REF="team:data-platform"

# Governed asynchronous spatial anonymization admission. The definition and
# execution-plan UUIDs must already exist in gda_control for the same tenant.
# Workload/policy settings fall back to the manual DataOps profile above.
export GDA_SPATIAL_ANONYMIZATION_DEFINITION_VERSION_ID=""
export GDA_SPATIAL_ANONYMIZATION_EXECUTION_PLAN_ARTIFACT_ID=""
export GDA_SPATIAL_ANONYMIZATION_WORKLOAD_SUBJECT="workload:dolphinscheduler-gda-dataops"
export GDA_SPATIAL_ANONYMIZATION_WORKLOAD_ROLES="platform_operator"
export GDA_SPATIAL_ANONYMIZATION_POLICY_VERSION_REF="gda://local-dev/policy/spatial-anonymization:v1"
export GDA_SPATIAL_ANONYMIZATION_POLICY_EVALUATOR_SUBJECT="workload:gda-policy-evaluator"
export GDA_SPATIAL_ANONYMIZATION_POLICY_TTL_SECONDS="86400"
export GDA_SPATIAL_ANONYMIZATION_INVOCATION_OWNER_REF="team:data-platform"
export GDA_SPATIAL_ANONYMIZATION_REQUEST_OWNER_REF="team:data-governance"
export GDA_DATAOPS_CANCEL_WORKLOAD_SUBJECT="workload:dolphinscheduler-gda-dataops"
export GDA_DATAOPS_CANCEL_POLICY_VERSION_REF="gda://local-dev/policy/dataops-cancel-sandbox:v1"
export GDA_DATAOPS_CANCEL_POLICY_EVALUATOR_SUBJECT="workload:gda-policy-evaluator"
export GDA_DATAOPS_CANCEL_POLICY_TTL_SECONDS="86400"
export GDA_APPROVAL_CASE_OWNER_REF="team:data-platform"

# Authenticated Alertmanager webhook workload allowed to reconcile approved SLO
# firing/resolved episodes into the unified DataIncident lifecycle.
export GDA_SLO_ALERT_DETECTOR_SUBJECT="workload:slo-alert-ingestor"

# Optional governed DataIncident -> Alertmanager delivery worker.
# Start with: docker compose --profile alerts up -d incident-notification-worker
# GDA_INCIDENT_NOTIFICATION_TENANT_ID="local-dev"
# GDA_ALERTMANAGER_URL="http://alertmanager:9093"
# GDA_ALERTMANAGER_BEARER_TOKEN_FILE="/run/secrets/alertmanager_token"
# GDA_INCIDENT_NOTIFICATION_BATCH_SIZE="10"
# GDA_INCIDENT_NOTIFICATION_LEASE_SECONDS="60"
# GDA_INCIDENT_NOTIFICATION_RETRY_SECONDS="30"
# GDA_INCIDENT_NOTIFICATION_POLL_SECONDS="5"
# GDA_ALERTMANAGER_TIMEOUT_SECONDS="10"

# Optional ApprovalCase lifecycle/SLA -> Alertmanager delivery worker.
# Start with: docker compose --profile alerts up -d approval-notification-worker
# GDA_APPROVAL_NOTIFICATION_TENANT_ID="local-dev"
# GDA_APPROVAL_NOTIFICATION_ROUTE_NAMESPACE="" # K8s injects metadata.namespace
# GDA_APPROVAL_NOTIFICATION_BATCH_SIZE="10"
# GDA_APPROVAL_NOTIFICATION_LEASE_SECONDS="60"
# GDA_APPROVAL_NOTIFICATION_RETRY_SECONDS="30"
# GDA_APPROVAL_NOTIFICATION_POLL_SECONDS="5"
# GDA_APPROVAL_NOTIFICATION_METRICS_PORT="9465"
# Reuses GDA_ALERTMANAGER_URL, token file, and timeout above.

# Optional Metadata Fabric lineage -> OpenMetadata projection worker.
# Start with: docker compose --profile metadata-fabric up -d metadata-fabric-worker master-metadata-worker
# GDA_METADATA_FABRIC_TENANT_ID="local-dev"
# GDA_OPENMETADATA_URL="http://openmetadata:8585"
# Host file mounted as a Compose secret; never put the token itself in .env.
# GDA_OPENMETADATA_BEARER_TOKEN_SOURCE="./secrets/openmetadata_token"
# For direct host execution, set the absolute in-process file path instead:
# GDA_OPENMETADATA_BEARER_TOKEN_FILE="/absolute/path/to/openmetadata_token"
# GDA_METADATA_FABRIC_BATCH_SIZE="10"
# GDA_METADATA_FABRIC_LEASE_SECONDS="360"
# GDA_METADATA_FABRIC_RETRY_SECONDS="30"
# GDA_METADATA_FABRIC_POLL_SECONDS="5"
# GDA_OPENMETADATA_TIMEOUT_SECONDS="10"

# Optional active master data -> bound OpenMetadata glossaryTerm worker.
# Uses the same metadata-fabric profile, provider URL and token file above.
# GDA_MASTER_METADATA_WORKER_ID="worker:master-metadata:openmetadata:compose"
# GDA_MASTER_METADATA_BATCH_SIZE="10"
# GDA_MASTER_METADATA_LEASE_SECONDS="360"
# GDA_MASTER_METADATA_RETRY_SECONDS="30"
# GDA_MASTER_METADATA_POLL_SECONDS="5"

# Optional governed PostGIS metric-query command worker.
# The platform control ledger continues to use POSTGRES_* above. The provider
# uses a separately scoped, read-only PostgreSQL URL stored in an owner-only
# (0400/0600) file; never put that URL or password directly in this env file.
# Start with: python -m data_agent.metric_query_command_worker validate
# Then:       python -m data_agent.metric_query_command_worker run
# GDA_METRIC_QUERY_TENANT_ID="local-dev"
# GDA_METRIC_QUERY_WORKER_ID="worker:metric-query-postgis:local-1"
# GDA_METRIC_QUERY_POSTGIS_DATABASE_URL_FILE="/run/secrets/metric_query_postgis_url"
# Must equal the URL user; it cannot be superuser or a platform gateway member.
# GDA_METRIC_QUERY_POSTGIS_DATABASE_ROLE="gda_metric_query_reader"
# Local/disposable profile:
# GDA_METRIC_QUERY_RESULT_BACKEND="local"
# GDA_METRIC_QUERY_RESULT_ROOT="/var/lib/gda/metric-query-results"
# Default lakehouse profile (credentials use the standard AWS SDK chain):
# GDA_METRIC_QUERY_RESULT_BACKEND="s3"
# The dedicated bucket must have versioning enabled and an Object Lock default
# retention rule. The worker fails readiness when either contract is absent.
# GDA_METRIC_QUERY_RESULT_S3_BUCKET="gis-agent-metric-query-results"
# GDA_METRIC_QUERY_RESULT_S3_PREFIX="metric-query-results/v1"
# GDA_METRIC_QUERY_RESULT_STORE_TIMEOUT_SECONDS="10"
# The API verifies the Artifact-bound VersionId and exact result bytes, then
# issues a 60-900 second signed GET URL for that same immutable version.
# Use a dedicated read-only identity or workload identity; do not reuse the writer.
# GDA_METRIC_QUERY_RESULT_ACCESS_KEY_ID=""
# GDA_METRIC_QUERY_RESULT_ACCESS_SECRET_ACCESS_KEY=""
# GDA_METRIC_QUERY_RESULT_ACCESS_SESSION_TOKEN=""
# GDA_METRIC_QUERY_RESULT_ACCESS_TIMEOUT_SECONDS="10"
# Set this when the caller cannot resolve the SDK verification endpoint above.
# GDA_METRIC_QUERY_RESULT_ACCESS_ENDPOINT_URL="https://objects.example.com"
# Logical authority from governed relation refs such as
# postgis://serving-local/metrics.metric_daily; this is not a database host.
# GDA_METRIC_QUERY_POSTGIS_RELATION_AUTHORITY="serving-local"
# GDA_METRIC_QUERY_POSTGIS_CONNECT_TIMEOUT_SECONDS="5"
# GDA_METRIC_QUERY_POSTGIS_STATEMENT_TIMEOUT_MS="30000"
# GDA_METRIC_QUERY_MAX_RESULT_ROWS="10000"
# GDA_METRIC_QUERY_BATCH_SIZE="10"
# S3 lease also covers conditional publication and exact read-back.
# GDA_METRIC_QUERY_LEASE_SECONDS="120"
# GDA_METRIC_QUERY_POLL_INTERVAL_SECONDS="5"
# GDA_METRIC_QUERY_STATUS_FILE="/tmp/gda-metric-query-command-worker.json"
# S3 health age also covers bucket probe, publication and exact read-back.
# GDA_METRIC_QUERY_HEALTH_MAX_AGE_SECONDS="180"

# Admin credentials for running migrations (only needed in entrypoint)
# POSTGRES_ADMIN_USER="postgres"
# POSTGRES_ADMIN_PASSWORD="postgres"

# --- Google AI (required — choose one method) --------------------------------
# Method 1: API Key (simpler)
# GOOGLE_API_KEY=your_google_api_key

# Method 2: Vertex AI (enterprise)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_CLOUD_LOCATION=global
# Mount service account JSON to /app/secrets/service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/service-account.json

# --- Gaode Maps API (required for geocoding, POI, admin boundary) ------------
export GAODE_API_KEY=your_gaode_api_key

# --- Chainlit Authentication (required) --------------------------------------
# Generate with: chainlit create-secret
CHAINLIT_AUTH_SECRET="generate_a_random_secret_here"

# --- Google OAuth2 (optional) ------------------------------------------------
# OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
# OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Huawei Cloud OBS (optional — cloud file storage) ------------------------
# export HUAWEI_OBS_AK="your_access_key"
# export HUAWEI_OBS_SK="your_secret_key"
# export HUAWEI_OBS_SERVER="https://obs.cn-north-4.myhuaweicloud.com"
# export HUAWEI_OBS_BUCKET="your_bucket_name"

# --- Local S3-compatible object storage / MMFE lakehouse (Docker MinIO) ------
# These defaults match docker-compose.yml. Use this for local TWM/MMFE data-lake
# validation; it is not a production S3 account.
export CLOUD_STORAGE_PROVIDER="aws"
export AWS_ENDPOINT_URL="http://minio:9000"
export AWS_ACCESS_KEY_ID="minio_admin"
export AWS_SECRET_ACCESS_KEY="local_dev_minio_secret"
export AWS_S3_BUCKET="gis-agent-uploads"
export AWS_REGION="us-east-1"
export MINIO_ROOT_USER="minio_admin"
export MINIO_ROOT_PASSWORD="local_dev_minio_secret"
export MMFE_LAKEHOUSE_BUCKET="gis-agent-lakehouse"
export MMFE_LAKEHOUSE_WAREHOUSE_URI="s3://gis-agent-lakehouse/warehouse"
export MMFE_STAC_CATALOG_URI="s3://gis-agent-lakehouse/catalog/stac"
export MMFE_ICEBERG_CATALOG="local"
export MMFE_ICEBERG_NAMESPACE="gis.fusion"
export MMFE_ICEBERG_TABLE="semantic_products"

# --- Tianditu Basemap (optional) ---------------------------------------------
# TIANDITU_TOKEN=your_tianditu_token

# --- Dynamic Planner (default: true) -----------------------------------------
export DYNAMIC_PLANNER=true

# --- Governed natural-resource ontology ------------------------------------
# Apache Jena Fuseki/TDB2 is the production RDF query projection. PostgreSQL
# remains authoritative for version, mappings, provenance, publication/audit;
# the immutable package remains the hash-verified fallback and export source.
export FUSEKI_IMAGE="gisdataagent-ontology-fuseki:5.5.0-nr-2.0.1"
export FUSEKI_JVM_ARGS="-Xms512m -Xmx2g -XX:+UseG1GC"
export ONTOLOGY_RUNTIME_BACKEND="auto"
export ONTOLOGY_SPARQL_ENDPOINT="http://ontology-rdf:3030/ontology/query"
export ONTOLOGY_SPARQL_TIMEOUT_SECONDS="5"
# Dedicated release-time DSN for the gda_ontology publisher role. Do not pass
# this credential to runtime application containers.
export ONTOLOGY_AUTHORITY_URL=""

# --- Self-Evolution Scheduler (optional, default: disabled) ------------------
# Runs conservative dry-run self-evolution cycles and persists candidates for
# admin review. It never deploys prompt changes or promotes eval datasets by
# itself; approval still happens in the admin dashboard.
export SELF_EVOLUTION_SCHEDULER_ENABLED=false
export SELF_EVOLUTION_SCHEDULER_INTERVAL_SECONDS=86400
export SELF_EVOLUTION_SCHEDULER_DAYS=7
export SELF_EVOLUTION_SCHEDULER_LIMIT=50
export SELF_EVOLUTION_SCHEDULER_MIN_SCORE=0.5
export SELF_EVOLUTION_SCHEDULER_INCLUDE_PROMPTS=false

# --- Usage Limits (optional) -------------------------------------------------
# DAILY_ANALYSIS_LIMIT=20          # Max analyses per user per day (0=unlimited, admin exempt)
# MONTHLY_TOKEN_LIMIT=0            # Max tokens per user per month (0=unlimited)

# --- Audit Log Retention (optional) ------------------------------------------
# AUDIT_LOG_RETENTION_DAYS=90

# --- ArcPy (not available in Docker — graceful degradation) ------------------
# ARCPY_PYTHON_EXE is intentionally not set in Docker

# --- Enterprise WeChat Bot (optional — PRD F7) ------------------------------
# Create a self-built app in WeCom admin (应用管理 → 自建应用)
# WECOM_CORP_ID=your_corp_id                    # 企业ID
# WECOM_APP_SECRET=your_app_secret              # 应用Secret
# WECOM_TOKEN=your_callback_token               # 接收消息 → Token
# WECOM_ENCODING_AES_KEY=your_43char_key        # 接收消息 → EncodingAESKey
# WECOM_AGENT_ID=1000002                        # 应用AgentId
# WECOM_SHARE_BASE_URL=https://gis.example.com  # Share link base URL (optional)
# Optional population/housing demo snapshot overrides. The boundary can also be
# read from snapshot_manifest.json when the product path is overridden.
export UWM_POPULATION_HOUSING_OPTIMIZATION_PATH=
export UWM_POPULATION_HOUSING_BOUNDARY_PATH=

# --- Land-use world-model runtimes (optional, server-side paths) ------------
# Existing World Model v1.1 Paper58/GeoSOS-FLUS external benchmark.
export TWM_PAPER58_BENCHMARK_DIR=
export TWM_WORLD_MODEL_V11_RUN_DIR=outputs/world_model_v11_runs
# Shared by the v1.1 runtime and the Abu Dhabi GeoSOS-FLUS runner.
export GEOSOS_FLUS_EXECUTABLE=
# Abu Dhabi three-model runtime overrides. Defaults resolve from the workspace.
export ABU_DHABI_LAND_USE_RUN_DIR=
export ABU_DHABI_PAPER58_RUNNER=
