# =============================================================================
# GIS Data Agent — Environment Variables
# Copy this file to data_agent/.env and fill in your values.
# Lines use 'export' prefix (bash-style) for compatibility.
# =============================================================================

# --- PostgreSQL / PostGIS (required) -----------------------------------------
# Default is the local multi-arch PostGIS + pgvector image. Build it with:
#   docker build -t gis-postgis-pgvector:16-3.4 docker/postgis-pgvector
export POSTGIS_IMAGE="gis-postgis-pgvector:16-3.4"
export POSTGRES_HOST="db"                    # Docker service name or external host
export POSTGRES_PORT="5432"
export POSTGRES_DATABASE="gis_agent"
export POSTGRES_USER="agent_user"
export POSTGRES_PASSWORD="change_me_strong_password"

# Connection capacity is a deployment budget, not a single pool knob. The
# Compose default reserves 20 of 150 server slots for migrations, monitoring,
# admin access, and non-GDA clients. Each API OS process may use at most
# 20 + 20 synchronous and 10 asynchronous connections. Background workers use
# the smaller GDA_WORKER_* pool configured in docker-compose.yml.
export POSTGRES_MAX_CONNECTIONS="150"
export POSTGRES_SUPERUSER_RESERVED_CONNECTIONS="5"
export POSTGRES_CONNECTION_RESERVE="20"
export DB_POOL_PROCESS_COUNT="1"
export DB_POOL_SIZE="20"
export DB_MAX_OVERFLOW="20"
export ASYNC_POOL_MIN="2"
export ASYNC_POOL_MAX="10"
# export GDA_WORKER_DB_POOL_SIZE="5"
# export GDA_WORKER_DB_MAX_OVERFLOW="0"

# Optional plan-bound pgvector projection repair target allowlist. Credentials
# stay in GDA_CONTROL_DATABASE_URL/DATABASE_URL; callers cannot override these
# schema/table/dimension bindings in repair requests.
# export GDA_VECTOR_PROJECTION_TARGETS_JSON='[{"tenant_id":"local-dev","projection_id":"cq.land_semantic_vectors","target_ref":"vector://db/public.land_semantic_vectors","schema_name":"public","table_name":"land_semantic_vectors","embedding_dimension":1024}]'

# Optional plan-bound RDF projection repair allowlist. Only the verified
# natural-resource-one-map 2.3.0 package is accepted. The Graph Store endpoint
# must be a separately secured writable endpoint; the bundled ontology-rdf
# service remains a read-only query projection.
# export GDA_RDF_PROJECTION_TARGETS_JSON='[{"tenant_id":"local-dev","projection_id":"cq.natural_resource_ontology","target_ref":"rdf://fuseki-writer/ontology/default","graph_store_endpoint":"http://fuseki-writer.internal:3030/ontology/data?default","package_dir":"/app/data_agent/ontology/packages/natural_resource_one_map/2.3.0","ontology_key":"natural-resource-one-map","semantic_version":"2.3.0","package_id":"natural-resource-one-map:2.3.0:587915868b1221af","package_content_sha256":"587915868b1221af2315508ede7bf7babced063cba8b261de2f10afa23841019","rdf_artifact_sha256":"7d709b1c3d03ab9b73e2413e9cf085d5730dbc1380eb9f8f0671b47eea911b27","expected_triple_count":537245}]'
# export GDA_RDF_PROJECTION_USERNAME='workload_identity'
# export GDA_RDF_PROJECTION_PASSWORD='from_secret_manager'
# export GDA_RDF_PROJECTION_TIMEOUT_SECONDS='120'

# Optional plan-bound S3 object projection repair allowlist. This example binds
# only the Chongqing customer artifact and the natural-resource-one-map 2.3.0
# ontology. Keep the registry server-side; repair requests carry no object
# endpoint, bucket, key, artifact bytes, or credentials.
# export GDA_OBJECT_PROJECTION_TARGETS_JSON='[{"tenant_id":"local-dev","projection_id":"cq.customer.heping_changed_parcels","target_ref":"s3://gis-agent-uploads/natural-resource-ontology-customer-demo-v1/heping_changed_parcels.geojson","endpoint_url":"http://minio:9000","region_name":"us-east-1","bucket":"gis-agent-uploads","key":"natural-resource-ontology-customer-demo-v1/heping_changed_parcels.geojson","bundle_manifest_path":"/app/data_agent/demo_data/natural_resource_ontology_customer_v1/manifest.json","bundle_manifest_sha256":"3fa52914ee6ce87e77c498adaba68b32a1d5206fa31ad4bd59e56e43bcc74531","bundle_id":"natural-resource-ontology-customer-demo-v1","bundle_version":"1.0.0","artifact_path":"/app/data_agent/demo_data/natural_resource_ontology_customer_v1/heping_changed_parcels.geojson","artifact_name":"heping_changed_parcels.geojson","artifact_sha256":"eb35068c4273fe25e07d99f822016f33b6fe29cd189b34aff037b9611e163bd3","artifact_size_bytes":1950576,"media_type":"application/geo+json","ontology_package_id":"natural-resource-one-map:2.3.0:587915868b1221af","ontology_package_content_sha256":"587915868b1221af2315508ede7bf7babced063cba8b261de2f10afa23841019"}]'
# export GDA_OBJECT_PROJECTION_ACCESS_KEY_ID='from_secret_manager'
# export GDA_OBJECT_PROJECTION_SECRET_ACCESS_KEY='from_secret_manager'
# export GDA_OBJECT_PROJECTION_SESSION_TOKEN=''
# export GDA_OBJECT_PROJECTION_TIMEOUT_SECONDS='120'

# Optional plan-bound Spark/Iceberg lakehouse projection repair allowlist. This
# binds only the normalized 445-feature Chongqing artifact and natural-resource
# ontology 2.3.0. Spark/container settings and credentials remain server-side.
# export GDA_LAKEHOUSE_PROJECTION_TARGETS_JSON='[{"tenant_id":"local-dev","projection_id":"cq.customer.heping_changed_parcels_lakehouse","target_ref":"iceberg://lakehouse/cq_customer/heping_changed_parcels","catalog":"lakehouse","namespace":"cq_customer","table":"heping_changed_parcels","warehouse_uri":"s3://gis-agent-lakehouse/warehouse/projections/cq_customer","endpoint_url":"http://minio:9000","region_name":"us-east-1","bucket":"gis-agent-lakehouse","bundle_manifest_path":"/app/data_agent/demo_data/natural_resource_ontology_customer_v1/manifest.json","bundle_manifest_sha256":"3fa52914ee6ce87e77c498adaba68b32a1d5206fa31ad4bd59e56e43bcc74531","bundle_id":"natural-resource-ontology-customer-demo-v1","bundle_version":"1.0.0","artifact_path":"/app/data_agent/demo_data/natural_resource_ontology_customer_v1/heping_changed_parcels.geojson","artifact_name":"heping_changed_parcels.geojson","artifact_sha256":"eb35068c4273fe25e07d99f822016f33b6fe29cd189b34aff037b9611e163bd3","artifact_size_bytes":1950576,"expected_table_content_sha256":"8d5339abfd8b7015e894791f3198cbe3f097470a9292b6e019f9ceb030e46dfb","expected_row_count":445,"ontology_package_id":"natural-resource-one-map:2.3.0:587915868b1221af","ontology_package_content_sha256":"587915868b1221af2315508ede7bf7babced063cba8b261de2f10afa23841019"}]'
# export GDA_LAKEHOUSE_PROJECTION_ACCESS_KEY_ID='from_secret_manager'
# export GDA_LAKEHOUSE_PROJECTION_SECRET_ACCESS_KEY='from_secret_manager'
# export GDA_LAKEHOUSE_PROJECTION_SESSION_TOKEN=''
# export GDA_LAKEHOUSE_PROJECTION_SPARK_IMAGE='gisdataagent/mmfe-spark-runtime:local'
# export GDA_LAKEHOUSE_PROJECTION_DOCKER_NETWORK='gisdataagent_agent-net'
# export GDA_LAKEHOUSE_PROJECTION_REPOSITORY_ROOT='/app'
# export GDA_LAKEHOUSE_PROJECTION_JAVA_HOME='/usr/lib/jvm/java-17-openjdk-arm64'
# export GDA_LAKEHOUSE_PROJECTION_TIMEOUT_SECONDS='600'

# Optional deployment-owned customer approval trust roots. REST/MCP requests
# cannot submit or override this registry. Store fingerprints, never private keys.
# export GDA_CUSTOMER_COMPENSATION_APPROVAL_TRUST_REGISTRY_JSON='[{"tenant_id":"local-dev","customer_authority_ref":"customer-authority:example","signature_key_id":"customer-key-ed25519","signature_algorithm":"ed25519","public_key_sha256":"<64 lowercase hex chars>","valid_from":"<RFC3339 UTC>","valid_until":"<RFC3339 UTC>","status":"active","anchor_sha256":"<computed anchor fingerprint>"}]'

# --- ArcGIS data ingestion --------------------------------------------------
# Host development may keep the embedded worker enabled. Docker/Kubernetes use
# a dedicated worker and override this to 0 in the application container.
export GDA_INGEST_EMBEDDED_WORKER="1"
# Local sandbox interval polling. Production sets this to external so
# DolphinScheduler owns schedules, backfills, resource queues, and alerts.
export GDA_INGEST_SCHEDULE_DRIVER="internal" # internal | external
export GDA_INGEST_LAKE_BACKEND="local" # local | cloud
export GDA_INGEST_LAKE_ROOT="data_agent/data_lake/raw"
export GDA_INGEST_LAKE_BUCKET="gis-agent-lakehouse"
export GDA_INGEST_LAKE_PREFIX="lakehouse/raw"
export GDA_INGEST_PLATFORM_BRIDGE="1"

# Governed DataOps manual admission. Bind these identities to OIDC/workload
# federation in production; they are not credentials and must not contain tokens.
export GDA_DATAOPS_MANUAL_WORKLOAD_SUBJECT="workload:dolphinscheduler-gda-dataops"
export GDA_DATAOPS_MANUAL_WORKLOAD_ROLES="platform_operator"
export GDA_DATAOPS_MANUAL_POLICY_VERSION_REF="gda://local-dev/policy/jqdltb-manual-sandbox:v1"
export GDA_DATAOPS_MANUAL_POLICY_EVALUATOR_SUBJECT="workload:gda-policy-evaluator"
export GDA_DATAOPS_MANUAL_POLICY_TTL_SECONDS="86400"
export GDA_DATAOPS_MANUAL_INVOCATION_OWNER_REF="team:data-platform"

# Governed asynchronous spatial anonymization admission. The definition and
# execution-plan UUIDs must already exist in gda_control for the same tenant.
# Workload/policy settings fall back to the manual DataOps profile above.
export GDA_SPATIAL_ANONYMIZATION_DEFINITION_VERSION_ID=""
export GDA_SPATIAL_ANONYMIZATION_EXECUTION_PLAN_ARTIFACT_ID=""
export GDA_SPATIAL_ANONYMIZATION_WORKLOAD_SUBJECT="workload:dolphinscheduler-gda-dataops"
export GDA_SPATIAL_ANONYMIZATION_WORKLOAD_ROLES="platform_operator"
export GDA_SPATIAL_ANONYMIZATION_POLICY_VERSION_REF="gda://local-dev/policy/spatial-anonymization:v1"
export GDA_SPATIAL_ANONYMIZATION_POLICY_EVALUATOR_SUBJECT="workload:gda-policy-evaluator"
export GDA_SPATIAL_ANONYMIZATION_POLICY_TTL_SECONDS="86400"
export GDA_SPATIAL_ANONYMIZATION_INVOCATION_OWNER_REF="team:data-platform"
export GDA_SPATIAL_ANONYMIZATION_REQUEST_OWNER_REF="team:data-governance"
export GDA_DATAOPS_CANCEL_WORKLOAD_SUBJECT="workload:dolphinscheduler-gda-dataops"
export GDA_DATAOPS_CANCEL_POLICY_VERSION_REF="gda://local-dev/policy/dataops-cancel-sandbox:v1"
export GDA_DATAOPS_CANCEL_POLICY_EVALUATOR_SUBJECT="workload:gda-policy-evaluator"
export GDA_DATAOPS_CANCEL_POLICY_TTL_SECONDS="86400"
export GDA_APPROVAL_CASE_OWNER_REF="team:data-platform"

# Public governed-query API security gate. Production/staging set this to 1
# and configure a deployment-owned tenant resolver for the live policy reader
# and immutable SecurityEventLedger audit adapter. No client request may supply
# or override these ports. Local development may leave it at 0 until such a
# resolver is installed.
export GDA_GOVERNED_QUERY_SECURITY_REQUIRED="0"

# Authenticated Alertmanager webhook workload allowed to reconcile approved SLO
# firing/resolved episodes into the unified DataIncident lifecycle.
export GDA_SLO_ALERT_DETECTOR_SUBJECT="workload:slo-alert-ingestor"

# Optional governed DataIncident -> Alertmanager delivery worker.
# Start with: docker compose --profile alerts up -d incident-notification-worker
# GDA_INCIDENT_NOTIFICATION_TENANT_ID="local-dev"
# GDA_INCIDENT_NOTIFICATION_ROUTE_NAMESPACE="" # K8s injects metadata.namespace
# GDA_ALERTMANAGER_URL="http://alertmanager:9093"
# GDA_ALERTMANAGER_BEARER_TOKEN_FILE="/run/secrets/alertmanager_token"
# GDA_INCIDENT_NOTIFICATION_BATCH_SIZE="10"
# GDA_INCIDENT_NOTIFICATION_LEASE_SECONDS="60"
# GDA_INCIDENT_NOTIFICATION_RETRY_SECONDS="30"
# GDA_INCIDENT_NOTIFICATION_POLL_SECONDS="5"
# GDA_INCIDENT_NOTIFICATION_METRICS_PORT="9465"
# GDA_ALERTMANAGER_TIMEOUT_SECONDS="10"

# Optional ApprovalCase lifecycle/SLA -> Alertmanager delivery worker.
# Start with: docker compose --profile alerts up -d approval-notification-worker
# GDA_APPROVAL_NOTIFICATION_TENANT_ID="local-dev"
# GDA_APPROVAL_NOTIFICATION_ROUTE_NAMESPACE="" # K8s injects metadata.namespace
# GDA_APPROVAL_NOTIFICATION_BATCH_SIZE="10"
# GDA_APPROVAL_NOTIFICATION_LEASE_SECONDS="60"
# GDA_APPROVAL_NOTIFICATION_RETRY_SECONDS="30"
# GDA_APPROVAL_NOTIFICATION_POLL_SECONDS="5"
# GDA_APPROVAL_NOTIFICATION_METRICS_PORT="9465"
# Reuses GDA_ALERTMANAGER_URL, token file, and timeout above.

# Optional Metadata Fabric lineage -> OpenMetadata projection worker.
# Start with: docker compose --profile metadata-fabric up -d metadata-fabric-worker master-metadata-worker
# GDA_METADATA_FABRIC_TENANT_ID="local-dev"
# GDA_OPENMETADATA_URL="http://openmetadata:8585"
# Host file mounted as a Compose secret; never put the token itself in .env.
# GDA_OPENMETADATA_BEARER_TOKEN_SOURCE="./secrets/openmetadata_token"
# Compose resolves SOURCE relative to the directory used to invoke Compose.
# For direct host execution, SOURCE is relative to the process working directory;
# alternatively set the absolute in-process FILE path instead:
# GDA_OPENMETADATA_BEARER_TOKEN_FILE="/absolute/path/to/openmetadata_token"
# If both are set, they must resolve to the same regular file.
# GDA_METADATA_FABRIC_BATCH_SIZE="10"
# GDA_METADATA_FABRIC_LEASE_SECONDS="360"
# GDA_METADATA_FABRIC_RETRY_SECONDS="30"
# GDA_METADATA_FABRIC_POLL_SECONDS="5"
# GDA_OPENMETADATA_TIMEOUT_SECONDS="10"
# Optional authenticated provider-read facade used by the platform gateway.
# Configure only the providers reachable from this API process; the endpoint
# reads an existing tenant-scoped binding and never copies provider JSON.
# GDA_METADATA_PROVIDER_READ_TIMEOUT_SECONDS="10"
# /ready probes configured providers using fixed health/version endpoints and
# fails closed on provider outage, unauthorized access, or protocol drift.
# GDA_METADATA_PROVIDER_HEALTH_TIMEOUT_SECONDS="2.5"
# GDA_GRAVITINO_URL="http://gravitino:8090"
# GDA_GRAVITINO_BEARER_TOKEN_FILE="/absolute/path/to/gravitino_token"
# GDA_OPENMETADATA_URL="http://openmetadata:8585"
# GDA_OPENMETADATA_BEARER_TOKEN_FILE="/absolute/path/to/openmetadata_token"

# Optional active master data -> bound OpenMetadata glossaryTerm worker.
# Uses the same metadata-fabric profile, provider URL and token file above.
# GDA_MASTER_METADATA_WORKER_ID="worker:master-metadata:openmetadata:compose"
# GDA_MASTER_METADATA_BATCH_SIZE="10"
# GDA_MASTER_METADATA_LEASE_SECONDS="360"
# GDA_MASTER_METADATA_RETRY_SECONDS="30"
# GDA_MASTER_METADATA_POLL_SECONDS="5"

# Managed DuckDB Blueprint command worker. `local` retains the single-host
# compatibility profile; `s3` uses exact object versions and does not require a
# shared API/worker data mount. The output bucket must have versioning and an
# Object Lock default retention rule. Credentials use the AWS SDK chain and
# belong only on the worker, never in an execution plan or receipt.
# GDA_BLUEPRINT_DUCKDB_RESULT_BACKEND="local"
# GDA_BLUEPRINT_DUCKDB_OUTPUT_ROOT="/var/lib/gda/blueprint-duckdb-results"
# GDA_BLUEPRINT_DUCKDB_RESULT_BACKEND="s3"
# GDA_BLUEPRINT_DUCKDB_OUTPUT_S3_BUCKET="gis-agent-blueprint-results"
# GDA_BLUEPRINT_DUCKDB_OUTPUT_S3_PREFIX="blueprint-duckdb-results/v1"
# GDA_BLUEPRINT_DUCKDB_INPUT_S3_PREFIXES="s3://gis-agent-lakehouse/products,s3://gis-agent-uploads/admitted"
# Compose-local scoped MinIO identity. Production injects equivalent values
# only into the worker through its secret/workload-identity authority.
# GDA_BLUEPRINT_DUCKDB_ACCESS_KEY_ID="gda_blueprint_worker"
# GDA_BLUEPRINT_DUCKDB_SECRET_ACCESS_KEY="replace_with_worker_only_secret"
# GDA_BLUEPRINT_DUCKDB_POLICY="gda-blueprint-duckdb-worker"
# GDA_BLUEPRINT_DUCKDB_TENANT_ID="local-dev"
# GDA_BLUEPRINT_DUCKDB_WORKER_ID="worker:blueprint-duckdb:local-1"
# GDA_BLUEPRINT_DUCKDB_BATCH_SIZE="1"
# GDA_BLUEPRINT_DUCKDB_LEASE_SECONDS="900"
# GDA_BLUEPRINT_DUCKDB_TIMEOUT_CEILING_SECONDS="600"
# GDA_BLUEPRINT_DUCKDB_IO_BUDGET_SECONDS="240"
# GDA_BLUEPRINT_DUCKDB_S3_CONNECT_TIMEOUT_SECONDS="5"
# GDA_BLUEPRINT_DUCKDB_S3_READ_TIMEOUT_SECONDS="60"
# GDA_BLUEPRINT_DUCKDB_RETRY_SECONDS="30"
# GDA_BLUEPRINT_DUCKDB_POLL_SECONDS="5"
# GDA_BLUEPRINT_DUCKDB_STATUS_FILE="/tmp/gda-duckdb-blueprint-command-worker.json"
# GDA_BLUEPRINT_DUCKDB_HEALTH_MAX_AGE_SECONDS="1200"
# The container image provides this immutable file. Bare-metal workers must
# install a DuckDB-version-matched signed extension before startup.
# GDA_BLUEPRINT_DUCKDB_SPATIAL_EXTENSION_PATH="/opt/gda/duckdb/spatial.duckdb_extension"
# Validate: python -m data_agent.duckdb_blueprint_command_worker validate
# Run:      python -m data_agent.duckdb_blueprint_command_worker run
# Compose:  docker compose --profile blueprint up -d duckdb-blueprint-worker

# Managed Martin provider-origin warmup worker. Local is a single-host
# compatibility profile. S3/MinIO stores the provider receipt at a stable,
# credential-free URI and binds the Artifact to an exact VersionId + ETag.
# The bucket must enable versioning and Object Lock default retention. Worker
# credentials use the standard AWS SDK chain and are never copied into status,
# execution plans, receipts, or Artifacts.
# GDA_GIS_WARMUP_TENANT_ID="local-dev"
# GDA_GIS_WARMUP_WORKER_ID="worker:gis-warmup:local-1"
# GDA_GIS_WARMUP_MARTIN_ORIGIN_URI="http://martin:3000"
# Governed OGC API Features route provider origin. Keep empty until the
# pygeoapi profile is deployed; the route fails closed when unset.
# PYGEOAPI_URL="http://pygeoapi:80"
# PYGEOAPI_PROVIDER_VERSION="0.25.dev0"
# Local/disposable profile:
# GDA_GIS_WARMUP_RECEIPT_BACKEND="local"
# GDA_GIS_WARMUP_RECEIPT_ROOT="/var/lib/gda/gis-warmup-receipts"
# Versioned object-storage profile:
# GDA_GIS_WARMUP_RECEIPT_BACKEND="s3"
# GDA_GIS_WARMUP_S3_BUCKET="gis-agent-evidence"
# GDA_GIS_WARMUP_S3_PREFIX="gis-warmup-receipts/v1"
# GDA_GIS_WARMUP_S3_CONNECT_TIMEOUT_SECONDS="5"
# GDA_GIS_WARMUP_S3_READ_TIMEOUT_SECONDS="60"
# GDA_GIS_WARMUP_PROVIDER_TIMEOUT_SECONDS="10"
# GDA_GIS_WARMUP_BATCH_SIZE="1"
# S3 lease covers at most 102 Martin requests plus put/head/get read-back.
# GDA_GIS_WARMUP_LEASE_SECONDS="1500"
# GDA_GIS_WARMUP_RETRY_DELAY_SECONDS="30"
# GDA_GIS_WARMUP_POLL_INTERVAL_SECONDS="5"
# GDA_GIS_WARMUP_STATUS_FILE="/tmp/gda-gis-endpoint-warmup-worker.json"

# Gateway-side shared MVT response cache. Authorization and access auditing run
# before every lookup. Redis is a rebuildable response projection; on outage
# the Gateway reads the private Martin origin.
# GDA_GIS_MVT_CACHE_REDIS_URL="redis://redis:6379/1"
# GDA_GIS_MVT_CACHE_KEY_PREFIX="gda:mvt:response:v1"
# GDA_GIS_MVT_CACHE_MAX_OBJECT_BYTES="1048576"
# GDA_GIS_MVT_CACHE_TIMEOUT_SECONDS="0.5"
# Dedicated worker for asynchronous cleanup after cutover/rollback. It does
# not participate in active-pointer transactions and fails closed on Redis
# errors. Override tenant and worker identity per deployment.
# GDA_GIS_MVT_CACHE_PURGE_TENANT_ID="planning"
# GDA_GIS_MVT_CACHE_PURGE_WORKER_ID="worker:gis-mvt-cache-purge:node-1"
# GDA_GIS_MVT_CACHE_PURGE_BATCH_SIZE="10"
# GDA_GIS_MVT_CACHE_PURGE_LEASE_SECONDS="60"
# GDA_GIS_MVT_CACHE_PURGE_RETRY_SECONDS="30"
# GDA_GIS_MVT_CACHE_PURGE_POLL_SECONDS="5"
# GDA_GIS_MVT_CACHE_PURGE_MAX_KEYS="10000"
# GDA_GIS_MVT_CACHE_PURGE_SCAN_COUNT="100"
# Provider selection is explicit. The default remains Redis. For an external
# HTTP purge service, set provider=http and provide a credential-free endpoint;
# the optional bearer token is read from a mounted 0600 file.
# GDA_GIS_MVT_CACHE_PURGE_PROVIDER="redis"
# GDA_GIS_MVT_CACHE_PURGE_HTTP_ENDPOINT_URL=""
# GDA_GIS_MVT_CACHE_PURGE_HTTP_BEARER_TOKEN_FILE=""
# GDA_GIS_MVT_CACHE_PURGE_HTTP_TIMEOUT_SECONDS="5"

# Optional automatic generic SLO activation -> GIS ServiceSLO binding worker.
# It claims a tenant-scoped reconciliation outbox and rechecks exact
# activation evidence before invoking the immutable binding authority.
# Start with: docker compose --profile gis-slo up -d gis-service-slo-reconciliation-worker
# GDA_GIS_SLO_RECONCILIATION_TENANT_ID="local-dev"
# GDA_GIS_SLO_RECONCILIATION_WORKER_ID="worker:gis-slo-reconciliation:node-1"
# GDA_GIS_SLO_RECONCILIATION_BATCH_SIZE="10"
# GDA_GIS_SLO_RECONCILIATION_LEASE_SECONDS="60"
# GDA_GIS_SLO_RECONCILIATION_RETRY_SECONDS="30"
# GDA_GIS_SLO_RECONCILIATION_POLL_SECONDS="5"

# Optional governed PostGIS metric-query command worker.
# The platform control ledger continues to use POSTGRES_* above. The provider
# uses a separately scoped, read-only PostgreSQL URL stored in an owner-only
# (0400/0600) file; never put that URL or password directly in this env file.
# Start with: python -m data_agent.metric_query_command_worker validate
# Then:       python -m data_agent.metric_query_command_worker run
# GDA_METRIC_QUERY_TENANT_ID="local-dev"
# GDA_METRIC_QUERY_WORKER_ID="worker:metric-query-postgis:local-1"
# GDA_METRIC_QUERY_POSTGIS_DATABASE_URL_FILE="/run/secrets/metric_query_postgis_url"
# Must equal the URL user; it cannot be superuser or a platform gateway member.
# GDA_METRIC_QUERY_POSTGIS_DATABASE_ROLE="gda_metric_query_reader"
# Local/disposable profile:
# GDA_METRIC_QUERY_RESULT_BACKEND="local"
# GDA_METRIC_QUERY_RESULT_ROOT="/var/lib/gda/metric-query-results"
# Default lakehouse profile (credentials use the standard AWS SDK chain):
# GDA_METRIC_QUERY_RESULT_BACKEND="s3"
# The dedicated bucket must have versioning enabled and an Object Lock default
# retention rule. The worker fails readiness when either contract is absent.
# GDA_METRIC_QUERY_RESULT_S3_BUCKET="gis-agent-metric-query-results"
# GDA_METRIC_QUERY_RESULT_S3_PREFIX="metric-query-results/v1"
# GDA_METRIC_QUERY_RESULT_STORE_TIMEOUT_SECONDS="10"
# The API verifies the Artifact-bound VersionId and exact result bytes, then
# issues a 60-900 second signed GET URL for that same immutable version.
# Use a dedicated read-only identity or workload identity; do not reuse the writer.
# GDA_METRIC_QUERY_RESULT_ACCESS_KEY_ID=""
# GDA_METRIC_QUERY_RESULT_ACCESS_SECRET_ACCESS_KEY=""
# GDA_METRIC_QUERY_RESULT_ACCESS_SESSION_TOKEN=""
# GDA_METRIC_QUERY_RESULT_ACCESS_TIMEOUT_SECONDS="10"
# Set this when the caller cannot resolve the SDK verification endpoint above.
# GDA_METRIC_QUERY_RESULT_ACCESS_ENDPOINT_URL="https://objects.example.com"
# Logical authority from governed relation refs such as
# postgis://serving-local/metrics.metric_daily; this is not a database host.
# GDA_METRIC_QUERY_POSTGIS_RELATION_AUTHORITY="serving-local"
# GDA_METRIC_QUERY_POSTGIS_CONNECT_TIMEOUT_SECONDS="5"
# GDA_METRIC_QUERY_POSTGIS_STATEMENT_TIMEOUT_MS="30000"
# GDA_METRIC_QUERY_MAX_RESULT_ROWS="10000"
# GDA_METRIC_QUERY_BATCH_SIZE="10"
# S3 lease also covers conditional publication and exact read-back.
# GDA_METRIC_QUERY_LEASE_SECONDS="120"
# GDA_METRIC_QUERY_POLL_INTERVAL_SECONDS="5"
# GDA_METRIC_QUERY_STATUS_FILE="/tmp/gda-metric-query-command-worker.json"
# S3 health age also covers bucket probe, publication and exact read-back.
# GDA_METRIC_QUERY_HEALTH_MAX_AGE_SECONDS="180"

# Optional governed PostGIS GIS-analysis command worker.
# This is distinct from metric-query execution and only accepts version-bound
# buffer, clip and intersection commands admitted by the GIS Run authority.
# Store the read-only PostGIS URL in an owner-only (0400/0600) file.
# Start with: python -m data_agent.gis_analysis_command_worker validate
# Then:       python -m data_agent.gis_analysis_command_worker run
# GDA_GIS_ANALYSIS_TENANT_ID="local-dev"
# GDA_GIS_ANALYSIS_WORKER_ID="worker:gis-analysis-postgis:local-1"
# GDA_GIS_ANALYSIS_POSTGIS_DATABASE_URL_FILE="/run/secrets/gis_analysis_postgis_url"
# GDA_GIS_ANALYSIS_POSTGIS_DATABASE_ROLE="gda_gis_analysis_reader"
# Local/disposable profile:
# GDA_GIS_ANALYSIS_RESULT_BACKEND="local"
# GDA_GIS_ANALYSIS_RESULT_ROOT="/var/lib/gda/gis-analysis-results"
# Default immutable S3/MinIO profile (standard AWS SDK writer credentials):
# GDA_GIS_ANALYSIS_RESULT_BACKEND="s3"
# GDA_GIS_ANALYSIS_RESULT_S3_BUCKET="gis-agent-gis-analysis-results"
# GDA_GIS_ANALYSIS_RESULT_S3_PREFIX="gis-analysis-results/v1"
# GDA_GIS_ANALYSIS_RESULT_STORE_TIMEOUT_SECONDS="10"
# API-side exact verification and short-lived GET signing use a separate
# read-only credential or workload identity. Never reuse the writer identity.
# GDA_GIS_ANALYSIS_RESULT_ACCESS_KEY_ID=""
# GDA_GIS_ANALYSIS_RESULT_ACCESS_SECRET_ACCESS_KEY=""
# GDA_GIS_ANALYSIS_RESULT_ACCESS_SESSION_TOKEN=""
# GDA_GIS_ANALYSIS_RESULT_ACCESS_TIMEOUT_SECONDS="10"
# GDA_GIS_ANALYSIS_RESULT_ACCESS_ENDPOINT_URL="https://objects.example.com"
# GDA_GIS_ANALYSIS_POSTGIS_CONNECT_TIMEOUT_SECONDS="5"
# GDA_GIS_ANALYSIS_POSTGIS_STATEMENT_TIMEOUT_CEILING_MS="30000"
# GDA_GIS_ANALYSIS_BATCH_SIZE="10"
# GDA_GIS_ANALYSIS_LEASE_SECONDS="120"
# GDA_GIS_ANALYSIS_POLL_INTERVAL_SECONDS="5"
# GDA_GIS_ANALYSIS_STATUS_FILE="/tmp/gda-gis-analysis-command-worker.json"
# GDA_GIS_ANALYSIS_HEALTH_MAX_AGE_SECONDS="180"

# Admin credentials for running migrations (only needed in entrypoint)
# POSTGRES_ADMIN_USER="postgres"
# POSTGRES_ADMIN_PASSWORD="postgres"

# --- Google AI (required — choose one method) --------------------------------
# Method 1: API Key (simpler)
# GOOGLE_API_KEY=your_google_api_key

# Method 2: Vertex AI (enterprise)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_CLOUD_LOCATION=global
# Mount service account JSON to /app/secrets/service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/service-account.json

# --- OpenAI GPT via ADK LiteLLM (optional alternative) ----------------------
# Keep the real key only in the local ignored .env file.
# OPENAI_API_KEY=sk-...
# MODEL_CONFIG_FORCE_ENV=true
# MODEL_FAST=gpt-5.6-luna
# MODEL_STANDARD=gpt-5.6-terra
# MODEL_PREMIUM=gpt-5.6-sol
# ROUTER_MODEL=gpt-5.6-luna
# NL2SQL_AGENT_MODEL=gpt-5.6-terra
# GDA_LLM_MODEL=gpt-5.6-terra
# NL2SQL_AGENT_FAMILY=openai
# GDA_LLM_PROVIDER=openai
# GDA_LLM_BASE_URL=https://api.openai.com/v1
# GDA_OPENAI_REASONING_EFFORT=low

# --- Gaode Maps API (required for geocoding, POI, admin boundary) ------------
export GAODE_API_KEY=your_gaode_api_key

# --- Chainlit Authentication (required) --------------------------------------
# Generate with: chainlit create-secret
CHAINLIT_AUTH_SECRET="generate_a_random_secret_here"

# --- Google OAuth2 (optional) ------------------------------------------------
# OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
# OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Huawei Cloud OBS (optional — cloud file storage) ------------------------
# export HUAWEI_OBS_AK="your_access_key"
# export HUAWEI_OBS_SK="your_secret_key"
# export HUAWEI_OBS_SERVER="https://obs.cn-north-4.myhuaweicloud.com"
# export HUAWEI_OBS_BUCKET="your_bucket_name"

# --- Local S3-compatible object storage / MMFE lakehouse (Docker MinIO) ------
# These defaults match docker-compose.yml. Use this for local TWM/MMFE data-lake
# validation; it is not a production S3 account.
export CLOUD_STORAGE_PROVIDER="aws"
export AWS_ENDPOINT_URL="http://minio:9000"
export AWS_ACCESS_KEY_ID="minio_admin"
export AWS_SECRET_ACCESS_KEY="local_dev_minio_secret"
export AWS_S3_BUCKET="gis-agent-uploads"
export AWS_REGION="us-east-1"
export MINIO_ROOT_USER="minio_admin"
export MINIO_ROOT_PASSWORD="local_dev_minio_secret"
export MMFE_LAKEHOUSE_BUCKET="gis-agent-lakehouse"
export MMFE_LAKEHOUSE_WAREHOUSE_URI="s3://gis-agent-lakehouse/warehouse"
export MMFE_STAC_CATALOG_URI="s3://gis-agent-lakehouse/catalog/stac"
export MMFE_ICEBERG_CATALOG="local"
export MMFE_ICEBERG_NAMESPACE="gis.fusion"
export MMFE_ICEBERG_TABLE="semantic_products"

# --- Tianditu Basemap (optional) ---------------------------------------------
# TIANDITU_TOKEN=your_tianditu_token

# --- Dynamic Planner (default: true) -----------------------------------------
export DYNAMIC_PLANNER=true

# --- Governed natural-resource ontology ------------------------------------
# Apache Jena Fuseki/TDB2 is the production RDF query projection. PostgreSQL
# remains authoritative for version, mappings, provenance, publication/audit;
# the immutable package remains the hash-verified fallback and export source.
export FUSEKI_IMAGE="gisdataagent-ontology-fuseki:5.5.0-nr-2.0.1"
export FUSEKI_JVM_ARGS="-Xms512m -Xmx2g -XX:+UseG1GC"
export ONTOLOGY_RUNTIME_BACKEND="auto"
export ONTOLOGY_SPARQL_ENDPOINT="http://ontology-rdf:3030/ontology/query"
export ONTOLOGY_SPARQL_TIMEOUT_SECONDS="5"
# Dedicated release-time DSN for the gda_ontology publisher role. Do not pass
# this credential to runtime application containers.
export ONTOLOGY_AUTHORITY_URL=""

# --- Self-Evolution Scheduler (optional, default: disabled) ------------------
# Runs conservative dry-run self-evolution cycles and persists candidates for
# admin review. It never deploys prompt changes or promotes eval datasets by
# itself; approval still happens in the admin dashboard.
export SELF_EVOLUTION_SCHEDULER_ENABLED=false
export SELF_EVOLUTION_SCHEDULER_INTERVAL_SECONDS=86400
export SELF_EVOLUTION_SCHEDULER_DAYS=7
export SELF_EVOLUTION_SCHEDULER_LIMIT=50
export SELF_EVOLUTION_SCHEDULER_MIN_SCORE=0.5
export SELF_EVOLUTION_SCHEDULER_INCLUDE_PROMPTS=false

# --- Usage Limits (optional) -------------------------------------------------
# DAILY_ANALYSIS_LIMIT=20          # Max analyses per user per day (0=unlimited, admin exempt)
# MONTHLY_TOKEN_LIMIT=0            # Max tokens per user per month (0=unlimited)

# --- Audit Log Retention (optional) ------------------------------------------
# AUDIT_LOG_RETENTION_DAYS=90

# --- ArcPy (not available in Docker — graceful degradation) ------------------
# ARCPY_PYTHON_EXE is intentionally not set in Docker

# --- Enterprise WeChat Bot (optional — PRD F7) ------------------------------
# Create a self-built app in WeCom admin (应用管理 → 自建应用)
# WECOM_CORP_ID=your_corp_id                    # 企业ID
# WECOM_APP_SECRET=your_app_secret              # 应用Secret
# WECOM_TOKEN=your_callback_token               # 接收消息 → Token
# WECOM_ENCODING_AES_KEY=your_43char_key        # 接收消息 → EncodingAESKey
# WECOM_AGENT_ID=1000002                        # 应用AgentId
# WECOM_SHARE_BASE_URL=https://gis.example.com  # Share link base URL (optional)
# Optional population/housing demo snapshot overrides. The boundary can also be
# read from snapshot_manifest.json when the product path is overridden.
export UWM_POPULATION_HOUSING_OPTIMIZATION_PATH=
export UWM_POPULATION_HOUSING_BOUNDARY_PATH=

# --- Land-use world-model runtimes (optional, server-side paths) ------------
# Existing World Model v1.1 Paper58/GeoSOS-FLUS external benchmark.
export TWM_PAPER58_BENCHMARK_DIR=
export TWM_WORLD_MODEL_V11_RUN_DIR=outputs/world_model_v11_runs
# Shared by the v1.1 runtime and the Abu Dhabi GeoSOS-FLUS runner.
export GEOSOS_FLUS_EXECUTABLE=
# Abu Dhabi three-model runtime overrides. Defaults resolve from the workspace.
export ABU_DHABI_LAND_USE_RUN_DIR=
export ABU_DHABI_PAPER58_RUNNER=
